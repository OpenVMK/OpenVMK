{
  "name": "@vmk/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VMK private server — serves the original Shockwave client and speaks its Director Multiuser protocol.",
  "scripts": {
    "start": "tsx src/assets.ts",
    "start:mus": "tsx src/mus-server.ts",
    "dev": "tsx watch src/assets.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx src/db.smoke.ts && tsx src/session.smoke.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "@types/node": "^22.13.10"
  }
}
