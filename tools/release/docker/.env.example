# Copy to .env and edit. Every line is optional; blank means the default.

# ---- Plain HTTP (the default) ----------------------------------------------
# Players open http://<this-server's-address>:5199 and it just works; leave the
# two PUBLIC lines blank.
#
# Host ports to publish (the container always uses 5199/8080 inside).
# If you change these, also set VMK_PUBLIC_ORIGIN and VMK_PUBLIC_GAME_URL so
# players are sent to the new ports.
VMK_HOST_WEB_PORT=5199
VMK_HOST_GAME_PORT=8080
# 0.0.0.0 = reachable from the network. 127.0.0.1 = this machine only.
VMK_BIND=0.0.0.0

# ---- On a domain with HTTPS ------------------------------------------------
# Point the domain's DNS at this server, open ports 80 and 443, then:
#   VMK_DOMAIN=vmk.example.com
#   VMK_PUBLIC_ORIGIN=https://vmk.example.com
#   VMK_PUBLIC_GAME_URL=wss://vmk.example.com/game
#   VMK_BIND=127.0.0.1
# and start with:  docker compose --profile https up -d
VMK_DOMAIN=
VMK_PUBLIC_ORIGIN=
VMK_PUBLIC_GAME_URL=

# ---- Players' real IPs (staff tools) ----------------------------------------
# Proxies whose X-Forwarded-For header is believed. Blank = the bundled Caddy
# (172.30.99.10) and this container's loopback only, which is right for both
# setups above. Using your OWN proxy instead? Add its address as VMK sees it:
# nginx on this host reaches the container from 172.30.99.1, so
#   VMK_TRUSTED_PROXIES=loopback,172.30.99.10,172.30.99.1
# Only list proxies you run: anything listed here can choose the IP staff see.
VMK_TRUSTED_PROXIES=

# ---- Files ------------------------------------------------------------------
# The container runs as this user so data/ and logs/ stay yours (`id -u`, `id -g`).
VMK_UID=1000
VMK_GID=1000

# ---- Game options -----------------------------------------------------------
# Seasonal decorations: blank (none), xmas or halloween.
VMK_SEASON=
# Chat filter: on (default) or off.
VMK_CHAT_CENSOR=on
TZ=UTC
