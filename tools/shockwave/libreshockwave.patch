+std::string managerClassPropertyKeyFromSymbol(const Datum& managerId) {
+    std::string symbolName;
+    if (const auto* symbol = managerId.asSymbol()) {
+        symbolName = symbol->name;
+    } else {
+        symbolName = toStringLikeJava(managerId);
+    }
+    while (!symbolName.empty() && symbolName.front() == '#') {
+        symbolName.erase(symbolName.begin());
+    }
+    for (char& ch : symbolName) {
+        if (ch == '_') {
+            ch = '.';
+        }
+    }
+    if (!symbolName.ends_with(".class")) {
+        symbolName += ".class";
+    }
+    return symbolName;
+}
+
+bool systemPropsFieldHasText(const Datum& field) {
+    if (field.isVoid()) {
+        return false;
+    }
+    if (const auto* fieldText = field.asFieldText()) {
+        return !fieldText->value.empty();
+    }
+    return !field.stringValue().empty();
+}
+
+bool isNonEmptyClassNameDatum(const Datum& datum) {
+    if (datum.isVoid()) {
+        return false;
+    }
+    if (datum.isString()) {
+        return !datum.stringValue().empty();
+    }
+    if (const auto* symbol = datum.asSymbol()) {
+        return !symbol->name.empty();
+    }
+    return false;
+}
+
+bool managerLookupTruthy(const Datum& value) {
+    if (value.isVoid() || value.isNull()) {
+        return false;
+    }
+    if (const auto* intValue = value.asInt()) {
+        return intValue->value != 0;
+    }
+    if (const auto* floatValue = value.asFloat()) {
+        return floatValue->value != 0.0f;
+    }
+    return true;
+}
+
+bool isClassesObjectId(const Datum& objectId) {
+    if (const auto* symbol = objectId.asSymbol()) {
+        return equalsIgnoreCase(symbol->name, "classes");
+    }
+    return equalsIgnoreCase(toStringLikeJava(objectId), "classes");
+}
+
+bool objectLookupMissing(const Datum& value) {
+    if (value.isVoid() || value.isNull()) {
+        return true;
+    }
+    if (const auto* intValue = value.asInt()) {
+        return intValue->value == 0;
+    }
+    return false;
+}
+
+Datum normalizeManagerId(const Datum& managerId) {
+    if (managerId.isSymbol()) {
+        return managerId;
+    }
+    std::string symbolName = toStringLikeJava(managerId);
+    while (!symbolName.empty() && symbolName.front() == '#') {
+        symbolName.erase(symbolName.begin());
+    }
+    return Datum::symbol(symbolName);
+}
