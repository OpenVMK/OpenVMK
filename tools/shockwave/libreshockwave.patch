+void dumpScriptHandlerProbe(DirectorFile* file, std::string_view memberName, std::string_view handlerName) {
+    if (file == nullptr) {
+        return;
+    }
+    std::shared_ptr<libreshockwave::chunks::ScriptChunk> script;
+    for (const auto& member : file->castMembers()) {
+        if (member && member->name() == memberName && member->isScript()) {
+            script = file->getScriptForCastMember(
+                member, file->casts().empty() ? nullptr : file->casts().front());
+            break;
+        }
+    }
+    if (!script) {
+        std::cout << "  [" << memberName << "] script missing\n";
+        return;
+    }
+
+    const auto names = file->getScriptNamesForScript(script);
+    const auto* handler = script->findHandlerPtr(handlerName, names.get());
+    std::cout << "  [" << memberName << "] handler " << handlerName << ": "
+              << (handler ? "found" : "NOT FOUND");
+    if (handler == nullptr) {
+        for (const auto& candidate : script->handlers()) {
+            const std::string resolved = script->getHandlerName(candidate, names.get());
+            if (equalsIgnoreCase(resolved, handlerName)) {
+                std::cout << " (fallback name match)";
+                break;
+            }
+        }
+    }
+    std::cout << " literals=" << script->literals().size()
+              << " directorVersion=" << (file->config() ? file->config()->directorVersion() : -1)
+              << " capitalX=" << (file->isCapitalX() ? "yes" : "no") << '\n';
+    if (names) {
+        std::cout << "  nameIds:";
+        for (int nameId : {50, 51, 52, 53, 54, 55, 314, 35}) {
+            std::cout << " " << nameId << "=\"" << names->getName(nameId) << "\"";
+        }
+        std::cout << '\n';
+    }
+
+    if (handler == nullptr) {
+        handler = script->findHandlerPtr(handlerName);
+    }
+    if (handler == nullptr) {
+        return;
+    }
+
+    for (const auto& instruction : handler->instructions) {
+        std::cout << "    " << instruction.toString();
+        if (instruction.opcode == libreshockwave::lingo::Opcode::PUSH_CONS) {
+            const int scaled = file->isCapitalX() || (file->config() && file->config()->directorVersion() < 500)
+                                   ? instruction.argument
+                                   : instruction.argument / 8;
+            std::cout << " scaledLiteral=" << scaled;
+            if (scaled >= 0 && scaled < static_cast<int>(script->literals().size())) {
+                const auto& lit = script->literals()[static_cast<std::size_t>(scaled)];
+                if (std::holds_alternative<std::string>(lit.value)) {
+                    const auto& text = std::get<std::string>(lit.value);
+                    std::cout << " (\"" << text << "\")";
+                }
+            }
+        } else if (instruction.opcode == libreshockwave::lingo::Opcode::EXT_CALL ||
+                   instruction.opcode == libreshockwave::lingo::Opcode::OBJ_CALL) {
+            if (names) {
+                std::cout << " name=\"" << names->getName(instruction.argument) << "\"";
+            }
+        } else if (instruction.opcode == libreshockwave::lingo::Opcode::PUSH_SYMB) {
+            if (names) {
+                std::cout << " sym=\"" << names->getName(instruction.argument) << "\"";
+            }
+        }
+        std::cout << '\n';
+    }
+}
