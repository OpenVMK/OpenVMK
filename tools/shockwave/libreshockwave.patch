+    in.seekg(0, std::ios::end);
+    const auto size = in.tellg();
+    in.seekg(0, std::ios::beg);
+    std::vector<std::uint8_t> data(static_cast<std::size_t>(size));
+    if (!data.empty()) {
+        in.read(reinterpret_cast<char*>(data.data()), size);
+    }
+    return data;
+}
+
+static bool matchesKeyword(std::string_view name) {
+    std::string lower(name);
+    std::ranges::transform(lower, lower.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+
+    // Escape hatches. The built-in list below was written for a login/network
+    // investigation and silently limits what this tool can ever show:
+    // everything we had extracted matched on "handler" (CRoomHandler,
+    // CSoundHandler, Navigator_Handler_Class), which is why the UI *components*
+    // â€” CUIComponent, CUIComponentPage â€” looked like they could not be
+    // decompiled at all. They decompile fine; they were filtered out.
+    //
+    //   LSW_EXPORT_ALL=1          export every handler
+    //   LSW_EXPORT_MATCH=foo,bar  export handlers/scripts matching these instead
+    //
+    // NOTE there is no keyword *argument*: argv[2..] are additional MOVIES, so
+    // passing a word on the command line tries to open it as a file.
+    if (const char* all = std::getenv("LSW_EXPORT_ALL"); all != nullptr && all[0] != '\0' && all[0] != '0') {
+        return true;
+    }
+    if (const char* custom = std::getenv("LSW_EXPORT_MATCH"); custom != nullptr && custom[0] != '\0') {
+        std::string needles(custom);
+        std::ranges::transform(needles, needles.begin(),
+                               [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+        std::size_t start = 0;
+        while (start <= needles.size()) {
+            const std::size_t comma = needles.find(',', start);
+            const std::string needle = needles.substr(start, comma == std::string::npos ? std::string::npos : comma - start);
+            if (!needle.empty() && lower.find(needle) != std::string::npos) {
+                return true;
+            }
+            if (comma == std::string::npos) {
+                break;
+            }
+            start = comma + 1;
+        }
+        return false;
+    }
+
+    static constexpr const char* kKeywords[] = {
+        "login", "handler", "connection", "multiuser", "multiusr", "security", "sec",
+        "loading", "getsec", "ticket", "hugeint", "secret", "net", "socket", "broker",
+    };
+    for (const char* keyword : kKeywords) {
+        if (lower.find(keyword) != std::string::npos) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void exportMovie(const fs::path& moviePath, const fs::path& outDir) {
+    auto file = DirectorFile::load(readFile(moviePath));
+    if (!file) {
+        std::cerr << "FAILED load " << moviePath << '\n';
+        return;
+    }
+    file->setBasePath(moviePath.parent_path().string());
+
+    const auto stem = moviePath.stem().string();
+    std::cout << "\n# " << moviePath.filename().string()
+              << " scripts=" << file->scripts().size() << '\n';
+
+    // LSW_DUMP_NAMES=1 dumps the resolved Lnam table plus, per script, its
+    // handler names and the names every extCall/objCall/pushSymb argument
+    // resolves to. Written because "the names look wrong" is an impression;
+    // this makes it a measurement.
+    if (const char* dump = std::getenv("LSW_DUMP_NAMES"); dump != nullptr && dump[0] != '\0' && dump[0] != '0') {
+        std::ofstream out(outDir / (stem + "__names.txt"));
+        out << "file=" << moviePath.filename().string()
+            << " version=" << file->version()
+            << " capitalX=" << (file->isCapitalX() ? "true" : "false")
+            << " scripts=" << file->scripts().size() << '\n';
+        for (const auto& script : file->scripts()) {
+            if (!script) continue;
+            const auto names = file->getScriptNamesForScript(script);
+            if (!names) continue;
+            out << "\n== script " << script->id().value()
+                << " (lnam entries=" << names->names().size() << ")\n";
+            for (const auto& handler : script->handlers()) {
+                out << "  handler nameId=" << handler.nameId
+                    << " -> " << script->resolveName(handler.nameId, names.get())
+                    << "  args=" << handler.argNameIds.size()
+                    << " locals=" << handler.localNameIds.size() << '\n';
+                for (const int argId : handler.argNameIds) {
+                    out << "      arg  " << argId << " -> " << script->resolveName(argId, names.get()) << '\n';
+                }
+            }
+            break; // one script is enough to judge the table
+        }
+        const auto names = file->scriptNames();
+        if (names) {
+            out << "\n== full Lnam (" << names->names().size() << " entries)\n";
+            for (std::size_t i = 0; i < names->names().size(); ++i) {
+                out << "  [" << i << "] " << names->names()[i] << '\n';
+            }
+        }
+        std::cout << "WROTE " << (stem + "__names.txt") << '\n';
+        return;
+    }
+
+    // LSW_EMIT_TS=1 runs LingoNodeTypeScript.cpp instead of the Lingo
+    // pretty-printer, writing .ts files that call into lingo-runtime.ts.
+    const bool emitTs = [] {
+        const char* v = std::getenv("LSW_EMIT_TS");
+        return v != nullptr && v[0] != '\0' && v[0] != '0';
+    }();
+
+    LingoDecompiler decompiler;
+    std::size_t exported = 0;
+
+    for (const auto& script : file->scripts()) {
+        if (!script) continue;
+        const auto names = file->getScriptNamesForScript(script);
+        const auto* namesPtr = names.get();
+        const std::string scriptName = file->getScriptName(script);
+        if (!matchesKeyword(scriptName) && scriptName.find('#') == std::string::npos) {
+            continue;
+        }
+        if (!matchesKeyword(scriptName)) {
+            // Also scan handler names
+            bool handlerHit = false;
+            for (const auto& handler : script->handlers()) {
+                const std::string handlerName = script->resolveName(handler.nameId, namesPtr);
+                if (matchesKeyword(handlerName)) {
+                    handlerHit = true;
+                    break;
+                }
+            }
+            if (!handlerHit) continue;
+        }
+
+        for (const auto& handler : script->handlers()) {
+            const std::string handlerName = script->resolveName(handler.nameId, namesPtr);
+            if (!matchesKeyword(scriptName) && !matchesKeyword(handlerName)) {
+                continue;
+            }
+
+            const auto safeName = [&]() {
+                std::string s = stem + "__" + scriptName + "__" + handlerName;
+                for (char& c : s) {
+                    if (!std::isalnum(static_cast<unsigned char>(c)) && c != '_' && c != '-') c = '_';
+                }
+                return s;
+            }();
+
+            const auto outPath = outDir / (safeName + (emitTs ? ".ts" : ".ls"));
+            // One handler that fails to decompile used to abort the whole run,
+            // which made a single bad script look like "this cast cannot be
+            // read". `CUIComponent` (d1ee027a script 99) is exactly that case:
+            // the export stopped dead after CTutorialWindow. Keep going and
+            // report which handler failed, so a partial dump is still usable.
+            std::string source;
+            try {
+                source = emitTs ? decompiler.emitTypeScriptHandler(handler, *script, namesPtr)
+                                : decompiler.decompileHandler(handler, *script, namesPtr);
+            } catch (const std::exception& error) {
+                std::cout << "SKIP " << scriptName << "::" << handlerName << " â€” " << error.what() << '\n';
+                continue;
+            } catch (...) {
+                std::cout << "SKIP " << scriptName << "::" << handlerName << " â€” unknown decompiler failure\n";
+                continue;
+            }
+            {
+                std::ofstream out(outPath);
+                // Comment syntax has to match the output language: a Lingo "--"
+                // header made every emitted .ts file a syntax error.
+                const char* commentPrefix = emitTs ? "// " : "-- ";
+                out << commentPrefix << moviePath.filename().string() << " / " << scriptName
+                    << " / " << handlerName << "\n\n";
+                if (emitTs) {
+                    // `_player` is Director's host object. The emitter renders
+                    // it as a bare identifier, so it must be imported or the
+                    // module throws ReferenceError on load.
+                    out << "import {\n"
+                        << "  callMethod, callNamed, chunkCount, chunkOf, deleteStringChunk, float,\n"
+                        << "  globalVar, lastChunk,\n"
+                        << "  lingoBinary, lingoTruthy,\n"
+                        // âš  `setGlobal` as well as `globalVar`: Lingo's `global`
+                        // declaration reads through one and writes through the
+                        // other, and the *_API bootstraps
+                        // (`CreateErrorManager`, `CreateObjectManager`) do the
+                        // write. Omitting it left 4 modules with a bare
+                        // identifier that only fails when the handler runs.
+                        << "  meProp, setGlobal, setMeProp, setTheProperty, setThePropOf, symbol, theProperty,\n"
+                        // LingoList/LingoPropList are constructed directly by
+                        // emitted code (918 sites across core.old), so they are
+                        // values, not just types.
+                        // `_key` is Lingo's `the key` object, emitted as a bare identifier the
+                        // same way `_player` is. Two cast handlers use it.
+                        // `_sound` is `the sound` object, same shape again â€”
+                        // `_sound.channel(n)`, used by CSoundChannelObject.
+                        << "  thePropOf, LingoList, LingoPropList, _player, _key, _sound,\n"
+                        << "  type LingoMe, type LingoValue,\n"
+                        << "} from \"../lingo/lingo-runtime.js\";\n\n";
+                }
+                out << source << '\n';
+            }
+            std::cout << "WROTE " << outPath.filename().string() << " (" << source.size() << " chars)\n";
+            ++exported;
+        }
+    }
+
+    if (exported == 0) {
+        std::cout << "(no keyword-matched handlers; listing all script names)\n";
+        for (const auto& info : file->getScriptInfoList()) {
+            std::cout << "  script id=" << info.scriptId << " name=" << info.scriptName << '\n';
+        }
+    }
+}
+
+int main(int argc, char** argv) {
+    if (argc < 3) {
+        std::cerr << "Usage: libreshockwave_lingo_export <output-dir> <movie>...\n";
+        return 2;
+    }
+
+    const fs::path outDir = argv[1];
+    fs::create_directories(outDir);
+
+    for (int i = 2; i < argc; ++i) {
+        exportMovie(argv[i], outDir);
+    }
+    return 0;
+}
+
