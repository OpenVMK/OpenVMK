+void runCreateVariableManagerProbe(DirectorFile* hostFile, CastLibManager& manager) {
+    if (hostFile == nullptr) {
+        return;
+    }
+
+    std::shared_ptr<libreshockwave::chunks::ScriptChunk> variableApiScript;
+    std::shared_ptr<DirectorFile> coreFile;
+    if (const auto castLib = manager.getCastLib(3)) {
+        coreFile = castLib->sourceFile();
+        if (coreFile) {
+            for (const auto& member : coreFile->castMembers()) {
+                if (member && member->name() == "Variable API" && member->isScript()) {
+                    variableApiScript = coreFile->getScriptForCastMember(
+                        member, coreFile->casts().empty() ? nullptr : coreFile->casts().front());
+                    break;
+                }
+            }
+        }
+    }
+    if (hostFile == nullptr || !variableApiScript || !coreFile) {
+        std::cout << "\n[CreateVariableManager VM probe] skipped\n";
+        return;
+    }
+
+    std::cout << "\n[CreateVariableManager VM probe]\n";
+    LingoVM vm(hostFile);
+    vm.setGlobalHandlerFinder([&manager, hostFile](std::string_view handlerName)
+        -> std::optional<libreshockwave::lingo::vm::HandlerRef> {
+        for (const auto& [_, castLib] : manager.castLibs()) {
+            if (!castLib || !castLib->isExternal() || !castLib->isLoaded()) {
+                continue;
+            }
+            const auto source = castLib->sourceFile();
+            const auto defaultNames = castLib->scriptNames();
+            for (const auto& script : castLib->allScripts()) {
+                if (!script) {
+                    continue;
+                }
+                const auto names = source ? source->getScriptNamesForScript(script) : defaultNames;
+                if (const auto* handler = script->findHandlerPtr(handlerName, names.get())) {
+                    return libreshockwave::lingo::vm::HandlerRef{
+                        script.get(),
+                        handler,
+                        script,
+                        source,
+                        names,
+                        castLib->scriptTypeForScript(script)
+                    };
+                }
+            }
+        }
+        (void)hostFile;
+        return std::nullopt;
+    });
+
+    BuiltinContext& builtinContext = vm.builtinContext();
+    manager.installBuiltinCallbacks(builtinContext);
+
+    const auto names = coreFile->getScriptNamesForScript(variableApiScript);
+    const auto* handler = variableApiScript->findHandlerPtr("CreateVariableManager", names.get());
+    if (handler == nullptr) {
+        std::cout << "  handler missing\n";
+        return;
+    }
+
+    const auto createManagerHandler = vm.findHandler("createManager");
+    std::cout << "  findHandler(createManager): " << (createManagerHandler ? "found" : "NOT FOUND") << '\n';
+
+    std::shared_ptr<libreshockwave::chunks::ScriptChunk> objectApiScript;
+    for (const auto& member : coreFile->castMembers()) {
+        if (member && member->name() == "Object API" && member->isScript()) {
+            objectApiScript = coreFile->getScriptForCastMember(
+                member, coreFile->casts().empty() ? nullptr : coreFile->casts().front());
+            break;
+        }
+    }
+    if (objectApiScript) {
+        const auto objectNames = coreFile->getScriptNamesForScript(objectApiScript);
+        if (const auto* createObjectManager = objectApiScript->findHandlerPtr("CreateObjectManager", objectNames.get())) {
+            const Datum objectManager = vm.executeHandler(*objectApiScript, *createObjectManager, {});
+            printHandlerResult("CreateObjectManager()", objectManager);
+        }
+    }
+
+    const Datum result = vm.executeHandler(*variableApiScript, *handler, {});
+    printHandlerResult("CreateVariableManager()", result);
+
+    const Datum recoveredManager =
+        vm.callHandler("createManager", {Datum::symbol("variable_manager"), Datum::voidValue()});
+    printHandlerResult("createManager(#variable_manager, VOID) recovery", recoveredManager);
+
+    if (vm.isInErrorState()) {
+        std::cout << "  VM error state: YES\n";
+    }
+}
