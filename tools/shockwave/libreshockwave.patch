+std::string describeDatumBrief(const Datum& datum) {
+    if (datum.isVoid()) {
+        return "void";
+    }
+    if (datum.isList()) {
+        return "list(" + std::to_string(datum.listValue().count()) + ")";
+    }
+    if (datum.isPropList()) {
+        return "propList(" + std::to_string(datum.propListValue().count()) + ")";
+    }
+    if (datum.isString()) {
+        const auto& value = datum.stringValue();
+        return value.size() > 48 ? "string(" + std::to_string(value.size()) + "b)" : "string(\"" + value + "\")";
+    }
+    if (const auto* symbol = datum.asSymbol()) {
+        return "symbol(" + symbol->name + ")";
+    }
