+﻿// Font resolution probe (VMK section 5l).
+//
+// Registers every PFR1 font embedded in the given casts exactly as
+// CastLib::scanXmedFonts does, then reports what each stage of
+// SimpleTextRenderer's font resolution would return for a requested face --
+// and how the PFR-rasterised metrics differ from the TTF we synthesise from
+// the same PFR. Renders a sample string through the public renderText so the
+// wrap can be inspected without the browser.
+//
+// Usage:
+//   libreshockwave_font_probe <cast.cct>... [--font "Foxley 816 Bold *"]
+//                                           [--size 16] [--text "..."]
+//                                           [--width 219] [--height 96]
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "libreshockwave/DirectorFile.hpp"
+#include "libreshockwave/bitmap/Bitmap.hpp"
+#include "libreshockwave/chunks/CastMemberChunk.hpp"
+#include "libreshockwave/chunks/RawChunk.hpp"
+#include "libreshockwave/font/BitmapFont.hpp"
+#include "libreshockwave/font/Pfr1Font.hpp"
+#include "libreshockwave/font/TtfBitmapRasterizer.hpp"
+#include "libreshockwave/io/BinaryReader.hpp"
+#include "libreshockwave/player/cast/CastLib.hpp"
+#include "libreshockwave/player/cast/FontRegistry.hpp"
+#include "libreshockwave/player/render/output/SimpleTextRenderer.hpp"
+
+namespace fs = std::filesystem;
+using libreshockwave::DirectorFile;
+using libreshockwave::font::BitmapFont;
+using libreshockwave::io::BinaryReader;
+using libreshockwave::player::cast::CastLib;
+using libreshockwave::player::cast::FontRegistry;
+using libreshockwave::player::render::output::SimpleTextRenderer;
+
+namespace {
+
+std::vector<std::uint8_t> readFile(const fs::path& path) {
+    std::ifstream in(path, std::ios::binary);
+    in.seekg(0, std::ios::end);
+    const auto size = in.tellg();
+    in.seekg(0, std::ios::beg);
+    std::vector<std::uint8_t> data(static_cast<std::size_t>(size));
+    if (!data.empty()) {
+        in.read(reinterpret_cast<char*>(data.data()), size);
+    }
+    return data;
+}
+
+// Mirrors CastLib::scanXmedFonts so the registry ends up in the same state the
+// player's would be in, without standing up a Player.
+std::vector<std::string> registerFontsFromCast(const fs::path& castPath) {
+    std::vector<std::string> registered;
+    auto file = DirectorFile::load(readFile(castPath));
+    if (!file) {
+        std::cout << "FAILED load " << castPath.filename().string() << '\n';
+        return registered;
+    }
+    file->setBasePath(castPath.parent_path().string());
+
+    CastLib::registerFontAliases(file);
+    if (!file->keyTable()) {
+        std::cout << "no key table in " << castPath.filename().string() << '\n';
+        return registered;
+    }
+
+    const auto xmedFourCC = BinaryReader::fourCC("XMED");
+    for (const auto& member : file->castMembers()) {
+        if (!member) {
+            continue;
+        }
+        for (const auto& chunk : file->getLinkedChunksForMember(member, xmedFourCC)) {
+            auto raw = std::dynamic_pointer_cast<libreshockwave::chunks::RawChunk>(chunk);
+            if (!raw || raw->data().size() < 4) {
+                continue;
+            }
+            const auto& data = raw->data();
+            if (data[0] == 'P' && data[1] == 'F' && data[2] == 'R' && data[3] == '1' &&
+                !member->name().empty()) {
+                FontRegistry::registerPfr1Font(member->name(), data);
+                std::cout << "  PFR1 " << member->name() << "  (" << data.size() << " b)\n";
+                registered.push_back(member->name());
+                // LSW_PFR_DUMP_DIR: write the raw PFR1 bytes out so a reference
+                // implementation (FreeType's pfr driver) can decode the very
+                // same font and act as an oracle for our own decoder.
+                if (const char* dumpDir = std::getenv("LSW_PFR_DUMP_DIR")) {
+                    std::string safe = member->name();
+                    for (auto& ch : safe) {
+                        if (ch == '*' || ch == '/' || ch == '\\' || ch == ':' || ch == ' ') {
+                            ch = '_';
+                        }
+                    }
+                    const fs::path out = fs::path(dumpDir) / (safe + ".pfr");
+                    std::ofstream os(out, std::ios::binary);
+                    os.write(reinterpret_cast<const char*>(data.data()),
+                             static_cast<std::streamsize>(data.size()));
+                    std::cout << "    dumped -> " << out.string() << '\n';
+                }
+            }
+        }
+    }
+    return registered;
+}
+
+void describePfr(const std::string& fontName) {
+    auto parsed = FontRegistry::getPfr1Font(fontName);
+    if (parsed == nullptr) {
+        std::cout << "  parsed PFR: (none)\n";
+        return;
+    }
+    std::size_t withContours = 0;
+    std::size_t withSetWidth = 0;
+    for (const auto& [code, glyph] : parsed->glyphs) {
+        if (!glyph.contours.empty()) {
+            ++withContours;
+        }
+        if (glyph.setWidth > 0.0F) {
+            ++withSetWidth;
+        }
+    }
+    std::cout << "  parsed PFR: internalName=\"" << parsed->fontName << "\""
+              << " outlineGlyphs=" << parsed->glyphs.size()
+              << " withContours=" << withContours
+              << " withSetWidth=" << withSetWidth
+              << " bitmapGlyphs=" << parsed->bitmapGlyphs.size()
+              << " hasBitmapSection=" << (parsed->metrics.hasBitmapSection ? "1" : "0")
+              << " blackPixel=" << (parsed->pfrBlackPixel ? "1" : "0")
+              << " charRecords=" << parsed->charRecords.size() << '\n';
+    if (!parsed->bitmapGlyphs.empty()) {
+        // The bitmap strike, where one exists, is authored at a fixed pixel
+        // size -- that size is the font's design size, and the only internal
+        // evidence of what "16 pt" was meant to look like.
+        std::cout << "    bitmap glyphs (all):\n";
+        std::vector<int> codes;
+        codes.reserve(parsed->bitmapGlyphs.size());
+        for (const auto& [code, _] : parsed->bitmapGlyphs) {
+            codes.push_back(code);
+        }
+        std::sort(codes.begin(), codes.end());
+        for (int code : codes) {
+            const auto& g = parsed->bitmapGlyphs.at(code);
+            std::cout << "      " << code << " '"
+                      << (code >= 32 && code < 127 ? static_cast<char>(code) : '?') << "' "
+                      << g.xSize << "x" << g.ySize << " @" << g.xPos << "," << g.yPos
+                      << " setWidth=" << g.setWidth << " fmt=" << g.imageFormat
+                      << " bytes=" << g.imageData.size() << '\n';
+        }
+    }
+
+    // Authored advances in font units: these are what the movie was laid out
+    // against, independent of whatever pixel size we rasterise at.
+    std::cout << "    authored setWidths (font units):";
+    for (const char* c : {"M", "n", "i", " ", ".", "W"}) {
+        for (const auto& record : parsed->charRecords) {
+            if (record.charCode == static_cast<int>(*c)) {
+                std::cout << " '" << c << "'=" << record.setWidth;
+                break;
+            }
+        }
+    }
+    std::cout << " (em=" << parsed->metrics.outlineResolution << ")\n";
+
+    // If every outline coordinate is a multiple of some large step, the face
+    // was drawn on a pixel grid and only lands on whole pixels at sizes that
+    // are multiples of em/step.
+    auto gcd = [](long a, long b) {
+        while (b != 0) {
+            const long t = a % b;
+            a = b;
+            b = t;
+        }
+        return a;
+    };
+    long coordGcd = 0;
+    long fractional = 0;
+    long total = 0;
+    std::map<int, long> onStep; // coords landing on an em/N grid
+    for (const auto& [_, glyph] : parsed->glyphs) {
+        for (const auto& contour : glyph.contours) {
+            for (const auto& command : contour.commands) {
+                for (float v : {command.x, command.y}) {
+                    ++total;
+                    if (v != static_cast<float>(static_cast<long>(v))) {
+                        ++fractional;
+                        continue;
+                    }
+                    const long iv = std::abs(static_cast<long>(v));
+                    coordGcd = gcd(coordGcd, iv);
+                    for (int step : {256, 128, 64}) {
+                        if (iv % step == 0) {
+                            ++onStep[step];
+                        }
+                    }
+                }
+            }
+        }
+    }
+    std::cout << "    outline grid: gcd=" << coordGcd << " over " << total << " coords ("
+              << fractional << " fractional)";
+    for (int step : {256, 128, 64}) {
+        std::cout << "  em/" << (parsed->metrics.outlineResolution / step) << "="
+                  << (total > 0 ? (100 * onStep[step] / total) : 0) << "%";
+    }
+    std::cout << '\n';
+    std::cout << "    metrics: outlineRes=" << parsed->metrics.outlineResolution
+              << " ascender=" << parsed->metrics.ascender
+              << " descender=" << parsed->metrics.descender
+              << " xMin=" << parsed->metrics.xMin
+              << " fontMatrix=[" << parsed->fontMatrix[0] << "," << parsed->fontMatrix[1]
+              << "," << parsed->fontMatrix[2] << "," << parsed->fontMatrix[3] << "]\n";
+}
+
+void describeFont(const char* label, const std::shared_ptr<BitmapFont>& font,
+                  const std::string& sample) {
+    if (font == nullptr) {
+        std::cout << "  " << label << ": NULL\n";
+        return;
+    }
+    std::cout << "  " << label << ": name=\"" << font->getFontName() << "\""
+              << " size=" << font->getFontSize()
+              << " cell=" << font->cellWidth() << "x" << font->cellHeight()
+              << " lineHeight=" << font->getLineHeight()
+              << " ascent=" << font->getAscent()
+              << " width(sample)=" << font->getStringWidth(sample) << '\n';
+    std::cout << "    advances:";
+    for (const char* c : {"M", "n", "i", " ", ".", "W"}) {
+        std::cout << " '" << c << "'=" << font->getCharWidth(static_cast<int>(*c));
+    }
+    std::cout << '\n';
+}
+
+// Ink extents + a crude row/column profile, enough to see where a line breaks.
+void describeRender(const std::shared_ptr<libreshockwave::bitmap::Bitmap>& bmp,
+                    std::uint32_t bgColor,
+                    bool ascii) {
+    if (bmp == nullptr) {
+        std::cout << "  render: NULL\n";
+        return;
+    }
+    const int w = bmp->width();
+    const int h = bmp->height();
+    int minX = w;
+    int minY = h;
+    int maxX = -1;
+    int maxY = -1;
+    std::size_t ink = 0;
+    std::map<std::uint32_t, std::size_t> colours;
+    std::vector<int> rowInk(static_cast<std::size_t>(h), 0);
+    for (int y = 0; y < h; ++y) {
+        for (int x = 0; x < w; ++x) {
+            const auto px = bmp->getPixel(x, y);
+            if ((px & 0x00FFFFFFU) == (bgColor & 0x00FFFFFFU)) {
+                continue;
+            }
+            ++ink;
+            ++rowInk[static_cast<std::size_t>(y)];
+            ++colours[px & 0x00FFFFFFU];
+            minX = std::min(minX, x);
+            maxX = std::max(maxX, x);
+            minY = std::min(minY, y);
+            maxY = std::max(maxY, y);
+        }
+    }
+    std::cout << "  render: " << w << "x" << h << " ink=" << ink
+              << " bounds=" << minX << "," << minY << "-" << maxX << "," << maxY
+              << " distinctColours=" << colours.size() << '\n';
+
+    // Text lines show up as runs of inked rows. Their pitch and per-line
+    // extents are directly comparable with the same measurement taken off the
+    // live client's canvas, which is what makes this an offline repro.
+    struct Line {
+        int top = 0;
+        int bottom = 0;
+        int minX = 0;
+        int maxX = 0;
+        std::size_t ink = 0;
+    };
+    std::vector<Line> lines;
+    for (int y = 0; y < h; ++y) {
+        if (rowInk[static_cast<std::size_t>(y)] == 0) {
+            continue;
+        }
+        int rowMin = w;
+        int rowMax = -1;
+        for (int x = 0; x < w; ++x) {
+            const auto px = bmp->getPixel(x, y);
+            if ((px & 0x00FFFFFFU) == (bgColor & 0x00FFFFFFU)) {
+                continue;
+            }
+            rowMin = std::min(rowMin, x);
+            rowMax = std::max(rowMax, x);
+        }
+        if (!lines.empty() && lines.back().bottom == y - 1) {
+            lines.back().bottom = y;
+            lines.back().minX = std::min(lines.back().minX, rowMin);
+            lines.back().maxX = std::max(lines.back().maxX, rowMax);
+            lines.back().ink += static_cast<std::size_t>(rowInk[static_cast<std::size_t>(y)]);
+        } else {
+            lines.push_back(Line{y, y, rowMin, rowMax,
+                                 static_cast<std::size_t>(rowInk[static_cast<std::size_t>(y)])});
+        }
+    }
+    std::cout << "    lines=" << lines.size() << '\n';
+    for (std::size_t i = 0; i < lines.size(); ++i) {
+        const auto& line = lines[i];
+        std::cout << "      y " << line.top << "-" << line.bottom
+                  << " (h" << (line.bottom - line.top + 1) << ")"
+                  << " x " << line.minX << "-" << line.maxX
+                  << " (w" << (line.maxX - line.minX + 1) << ")"
+                  << " ink " << line.ink;
+        if (i > 0) {
+            std::cout << "  pitch " << (line.top - lines[i - 1].top);
+        }
+        std::cout << '\n';
+    }
+    std::cout << "    colours:";
+    for (const auto& [colour, count] : colours) {
+        std::cout << " " << ((colour >> 16) & 0xFF) << "," << ((colour >> 8) & 0xFF)
+                  << "," << (colour & 0xFF) << "x" << count;
+    }
+    std::cout << '\n';
+
+    if (ascii && maxX >= minX && maxY >= minY) {
+        // '#' full ink, '+' partial: an antialiased edge shows as '+', a
+        // hard-edged one never does. Directly comparable with the same dump
+        // taken off the live canvas.
+        std::cout << "    ascii (ink bounds):\n";
+        for (int y = minY; y <= maxY; ++y) {
+            std::string row = "      ";
+            for (int x = minX; x <= maxX; ++x) {
+                const auto px = bmp->getPixel(x, y);
+                if ((px & 0x00FFFFFFU) == (bgColor & 0x00FFFFFFU)) {
+                    row.push_back('.');
+                    continue;
+                }
+                const int r = static_cast<int>((px >> 16) & 0xFF);
+                const int g = static_cast<int>((px >> 8) & 0xFF);
+                const int b = static_cast<int>(px & 0xFF);
+                row.push_back((r + g + b) / 3 > 200 ? '#' : '+');
+            }
+            std::cout << row << '\n';
+        }
+    }
+}
+
+// Rasterise a few glyphs to ASCII at the given size. A face drawn on a pixel
+// grid has uniform stems at its design size and ragged ones anywhere else, so
+// this is the direct check that a size is right.
+void dumpGlyphs(const std::string& fontName, int size, const std::string& chars) {
+    auto font = FontRegistry::getPfrBitmapFont(fontName, size);
+    if (font == nullptr) {
+        std::cout << "  (no PFR font at " << size << ")\n";
+        return;
+    }
+    const int cw = font->cellWidth();
+    const int ch = font->cellHeight();
+    std::cout << "  size " << size << " cell " << cw << "x" << ch
+              << " lineHeight " << font->getLineHeight() << '\n';
+    for (char c : chars) {
+        const int code = static_cast<unsigned char>(c);
+        std::vector<std::uint32_t> buf(static_cast<std::size_t>(cw * ch), 0);
+        font->drawChar(code, buf, cw, ch, 0, 0, 0xFFFFFFFFU);
+        std::cout << "    '" << c << "' advance=" << font->getCharWidth(code) << '\n';
+        for (int y = 0; y < ch; ++y) {
+            std::string row = "      ";
+            bool any = false;
+            for (int x = 0; x < cw; ++x) {
+                const auto px = buf[static_cast<std::size_t>(y * cw + x)];
+                const bool on = ((px >> 24) & 0xFF) > 0;
+                row.push_back(on ? '#' : '.');
+                any = any || on;
+            }
+            if (any) {
+                std::cout << row << '\n';
+            }
+        }
+    }
+}
+
+// Greedy word wrap using the resolved font's own advances -- what Director
+// does, and what makes a period screenshot directly comparable: if the metrics
+// are right, the same string in the same field breaks at the same words.
+void dumpWrap(const std::string& fontName, int fontSize, const std::string& text, int wrapWidth) {
+    auto font = FontRegistry::getBitmapFont(fontName, fontSize);
+    if (font == nullptr) {
+        std::cout << "  (no font)\n";
+        return;
+    }
+    std::vector<std::string> words;
+    std::string current;
+    for (char c : text) {
+        if (c == ' ') {
+            words.push_back(current);
+            current.clear();
+        } else {
+            current.push_back(c);
+        }
+    }
+    words.push_back(current);
+
+    std::string line;
+    int lineNo = 0;
+    auto flush = [&]() {
+        if (line.empty()) {
+            return;
+        }
+        ++lineNo;
+        std::cout << "    " << lineNo << ": w=" << font->getStringWidth(line) << "  \"" << line
+                  << "\"\n";
+        line.clear();
+    };
+    for (const auto& word : words) {
+        const std::string candidate = line.empty() ? word : line + " " + word;
+        if (!line.empty() && font->getStringWidth(candidate) > wrapWidth) {
+            flush();
+            line = word;
+        } else {
+            line = candidate;
+        }
+    }
+    flush();
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    std::vector<fs::path> casts;
+    std::string fontName = "Foxley 816 Bold *";
+    std::string text =
+        "Cannot start VMK. The game was unable to download all required resources. "
+        "Please first check your internet connection and try again. If the";
+    int fontSize = 16;
+    int width = 219;
+    int height = 96;
+    std::string alignment = "center";
+    std::string style = "bold";
+    std::string glyphChars;
+
+    for (int i = 1; i < argc; ++i) {
+        const std::string arg = argv[i];
+        auto next = [&]() -> std::string { return i + 1 < argc ? argv[++i] : std::string{}; };
+        if (arg == "--font") {
+            fontName = next();
+        } else if (arg == "--size") {
+            fontSize = std::stoi(next());
+        } else if (arg == "--text") {
+            text = next();
+        } else if (arg == "--width") {
+            width = std::stoi(next());
+        } else if (arg == "--height") {
+            height = std::stoi(next());
+        } else if (arg == "--align") {
+            alignment = next();
+        } else if (arg == "--style") {
+            style = next();
+        } else if (arg == "--glyphs") {
+            glyphChars = next();
+        } else {
+            casts.emplace_back(arg);
+        }
+    }
+
+    if (casts.empty()) {
+        std::cerr << "Usage: libreshockwave_font_probe <cast.cct>... [--font NAME]"
+                     " [--size N] [--text S] [--width N] [--height N]\n";
+        return 2;
+    }
+
+    std::cout << "== registering PFR1 fonts ==\n";
+    for (const auto& cast : casts) {
+        std::cout << cast.filename().string() << '\n';
+        registerFontsFromCast(cast);
+    }
+
+    std::cout << "\n== request: \"" << fontName << "\" @ " << fontSize << " ==\n";
+    const auto alias = FontRegistry::getFontAlias(fontName);
+    std::cout << "  alias: "
+              << (alias.has_value()
+                      ? "\"" + alias->fontName + "\" bold=" + (alias->bold ? "1" : "0")
+                      : std::string("(none)"))
+              << '\n';
+    const auto resolved = FontRegistry::resolveFont(fontName);
+    std::cout << "  resolveFont: "
+              << (resolved.has_value() ? "\"" + *resolved + "\"" : std::string("(none)")) << '\n';
+    // The alias target is what the resolution chain actually looks up, so this
+    // is the line that shows which face a plain request lands on.
+    if (alias.has_value()) {
+        const auto aliasResolved = FontRegistry::resolveFont(alias->fontName);
+        std::cout << "  resolveFont(alias target \"" << alias->fontName << "\"): "
+                  << (aliasResolved.has_value() ? "\"" + *aliasResolved + "\""
+                                                : std::string("(none)"))
+                  << "   canonical=\"" << FontRegistry::canonicalFontName(alias->fontName) << "\"\n";
+    }
+    std::cout << "  canonical(\"" << fontName << "\")=\"" << FontRegistry::canonicalFontName(fontName)
+              << "\"\n";
+    std::cout << "  hasPfrFont=" << (FontRegistry::hasPfrFont(fontName) ? "yes" : "no")
+              << "  ttfBytes=" << (FontRegistry::getTtfBytes(fontName).has_value() ? "yes" : "no")
+              << '\n';
+    describePfr(fontName);
+
+    const std::string sample = "Cannot start VMK.";
+    std::cout << "\n== candidate fonts (sample \"" << sample << "\") ==\n";
+    describeFont("getPfrBitmapFont      ", FontRegistry::getPfrBitmapFont(fontName, fontSize), sample);
+    describeFont("getEmbeddedBitmapFont ",
+                 FontRegistry::getEmbeddedBitmapFont(fontName, fontSize, false, false), sample);
+    describeFont("getEmbeddedBitmapFont+bold",
+                 FontRegistry::getEmbeddedBitmapFont(fontName, fontSize, true, false), sample);
+    describeFont("getBitmapFont         ", FontRegistry::getBitmapFont(fontName, fontSize), sample);
+
+    // Both antialias settings, so the caller can see what the flag actually
+    // buys for this face rather than assuming.
+    SimpleTextRenderer renderer;
+    const int bg = 0x00001F55;
+    for (bool wantAntialias : {true, false}) {
+        std::cout << "\n== renderText into " << width << "x" << height
+                  << " align=" << alignment << " style=" << style
+                  << " antialias=" << (wantAntialias ? "1" : "0") << " ==\n";
+        auto bmp = renderer.renderText(text, width, height, fontName, fontSize, style, alignment,
+                                       0x00EFEFEF, bg, true, wantAntialias, 0, 0);
+        describeRender(bmp, static_cast<std::uint32_t>(bg), !glyphChars.empty());
+    }
+
+    std::cout << "\n== getLineHeight(\"" << fontName << "\", " << fontSize << ", \"" << style
+              << "\") = " << renderer.getLineHeight(fontName, fontSize, style, 0) << '\n';
+
+    std::cout << "\n== word wrap at " << width << "px ==\n";
+    dumpWrap(fontName, fontSize, text, width);
+
+    if (!glyphChars.empty()) {
+        std::cout << "\n== glyph raster: PFR outline rasteriser (BitmapFont::fromPfr1) ==\n";
+        for (int size : {fontSize - 1, fontSize}) {
+            dumpGlyphs(fontName, size, glyphChars);
+        }
+
+        // The other half of registerPfr1Font: the PFR converted to TTF and run
+        // through the normal TTF rasteriser. For a genuine outline typeface this
+        // is the path that should win; for a pixel font it is the one that
+        // smears it.
+        std::cout << "\n== glyph raster: synthesised TTF (Pfr1TtfConverter -> TtfBitmapRasterizer) ==\n";
+        if (const auto ttf = FontRegistry::getTtfBytes(fontName); ttf.has_value()) {
+            auto font = libreshockwave::font::TtfBitmapRasterizer::rasterize(*ttf, fontSize, fontName);
+            if (font == nullptr) {
+                std::cout << "  (rasterize returned null)\n";
+            } else {
+                std::cout << "  size " << fontSize << " cell " << font->cellWidth() << "x"
+                          << font->cellHeight() << " lineHeight " << font->getLineHeight() << '\n';
+                for (char c : glyphChars) {
+                    const int code = static_cast<unsigned char>(c);
+                    const int cw = font->cellWidth();
+                    const int ch = font->cellHeight();
+                    std::vector<std::uint32_t> buf(static_cast<std::size_t>(cw * ch), 0);
+                    font->drawChar(code, buf, cw, ch, 0, 0, 0xFFFFFFFFU);
+                    std::cout << "    '" << c << "' advance=" << font->getCharWidth(code) << '\n';
+                    for (int y = 0; y < ch; ++y) {
+                        std::string row = "      ";
+                        bool any = false;
+                        for (int x = 0; x < cw; ++x) {
+                            const auto alpha = (buf[static_cast<std::size_t>(y * cw + x)] >> 24) & 0xFF;
+                            row.push_back(alpha > 200 ? '#' : (alpha > 60 ? '+' : '.'));
+                            any = any || alpha > 0;
+                        }
+                        if (any) {
+                            std::cout << row << '\n';
+                        }
+                    }
+                }
+            }
+        } else {
+            std::cout << "  (no TTF bytes registered)\n";
+        }
+    }
+
+    return 0;
+}
+
diff --git a/cpp/apps/tools/GetSecCastBuilder.cpp b/cpp/apps/tools/GetSecCastBuilder.cpp
new file mode 100644
index 0000000..bc9363f
--- /dev/null
+++ b/cpp/apps/tools/GetSecCastBuilder.cpp
@@ -0,0 +1,399 @@
+// Build a minimal external cast (.cct) for VMK GetSec / loading.php.
+//
+// The vmk_8 CInit score script expects castLib(3) (loading.php response) to contain
+// member("CSpecialScript") with handlers:
+//   script("CSpecialScript").handlers(58.31005859375)  -> m_sSecretCode
+//   script("CSpecialScript").tCode(29.3367958068848)     -> m_sSecretCode2
+//   script("CSpecialScript").tCode(5437434)              -> m_sSecretCode3
+//
+// Usage:
+//   libreshockwave_getsec_cast <secret1> <secret2> <secret3> [output.cct]
+// If output is omitted, writes raw bytes to stdout.
+#include <bit>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "libreshockwave/DirectorFile.hpp"
+#include "libreshockwave/cast/MemberType.hpp"
+#include "libreshockwave/chunks/CastMemberChunk.hpp"
+#include "libreshockwave/chunks/ScriptChunk.hpp"
+#include "libreshockwave/io/BinaryReader.hpp"
+#include "libreshockwave/lingo/Opcode.hpp"
+
+using libreshockwave::DirectorFile;
+using libreshockwave::cast::MemberType;
+using libreshockwave::io::BinaryReader;
+using libreshockwave::lingo::Opcode;
+
+namespace {
+
+constexpr int kDirectorVersion = 0x04B1;
+constexpr float kTCodeKey2 = 29.3367958068848F;
+constexpr int kTCodeKey3 = 5437434;
+// LingoVM scales PUSH_CONS / GET_PARAM indices by 8 for Director version >= 500.
+constexpr int kLiteralScale = 8;
+
+struct Secrets {
+    std::string code1;
+    std::string code2;
+    std::string code3;
+};
+
+void appendFourCC(std::vector<std::uint8_t>& data, const char* value) {
+    data.push_back(static_cast<std::uint8_t>(value[0]));
+    data.push_back(static_cast<std::uint8_t>(value[1]));
+    data.push_back(static_cast<std::uint8_t>(value[2]));
+    data.push_back(static_cast<std::uint8_t>(value[3]));
+}
+
+void appendI16(std::vector<std::uint8_t>& data, int value) {
+    const auto raw = static_cast<std::uint16_t>(value);
+    data.push_back(static_cast<std::uint8_t>((raw >> 8) & 0xFF));
+    data.push_back(static_cast<std::uint8_t>(raw & 0xFF));
+}
+
+void appendI32(std::vector<std::uint8_t>& data, std::uint32_t value) {
+    data.push_back(static_cast<std::uint8_t>((value >> 24) & 0xFF));
+    data.push_back(static_cast<std::uint8_t>((value >> 16) & 0xFF));
+    data.push_back(static_cast<std::uint8_t>((value >> 8) & 0xFF));
+    data.push_back(static_cast<std::uint8_t>(value & 0xFF));
+}
+
+void putI16At(std::vector<std::uint8_t>& data, int offset, int value) {
+    const auto raw = static_cast<std::uint16_t>(value);
+    data[static_cast<std::size_t>(offset)] = static_cast<std::uint8_t>((raw >> 8) & 0xFF);
+    data[static_cast<std::size_t>(offset + 1)] = static_cast<std::uint8_t>(raw & 0xFF);
+}
+
+void putI32At(std::vector<std::uint8_t>& data, int offset, std::uint32_t value) {
+    data[static_cast<std::size_t>(offset)] = static_cast<std::uint8_t>((value >> 24) & 0xFF);
+    data[static_cast<std::size_t>(offset + 1)] = static_cast<std::uint8_t>((value >> 16) & 0xFF);
+    data[static_cast<std::size_t>(offset + 2)] = static_cast<std::uint8_t>((value >> 8) & 0xFF);
+    data[static_cast<std::size_t>(offset + 3)] = static_cast<std::uint8_t>(value & 0xFF);
+}
+
+void appendPascal(std::vector<std::uint8_t>& data, const std::string& value) {
+    data.push_back(static_cast<std::uint8_t>(value.size()));
+    data.insert(data.end(), value.begin(), value.end());
+}
+
+void appendLiteralString(std::vector<std::uint8_t>& data, const std::string& value) {
+    appendI32(data, static_cast<std::uint32_t>(value.size() + 1));
+    data.insert(data.end(), value.begin(), value.end());
+    data.push_back(0);
+}
+
+void appendLiteralFloat(std::vector<std::uint8_t>& data, float value) {
+    appendI32(data, 4);
+    const auto bits = std::bit_cast<std::uint32_t>(value);
+    appendI32(data, bits);
+}
+
+std::vector<std::uint8_t> buildRifx(const std::vector<std::pair<std::string, std::vector<std::uint8_t>>>& chunks) {
+    constexpr int mmapOffset = 32;
+    const int mmapPayloadLength = 24 + static_cast<int>(chunks.size()) * 20;
+    int payloadStart = mmapOffset + 8 + mmapPayloadLength;
+
+    std::vector<int> offsets;
+    offsets.reserve(chunks.size());
+    for (const auto& chunk : chunks) {
+        offsets.push_back(payloadStart - 8);
+        payloadStart += static_cast<int>(chunk.second.size());
+    }
+
+    std::vector<std::uint8_t> data;
+    appendFourCC(data, "RIFX");
+    appendI32(data, 0);
+    appendFourCC(data, "MV93");
+    appendFourCC(data, "imap");
+    appendI32(data, 12);
+    appendI32(data, 1);
+    appendI32(data, mmapOffset);
+    appendI32(data, static_cast<std::uint32_t>(kDirectorVersion));
+    appendFourCC(data, "mmap");
+    appendI32(data, static_cast<std::uint32_t>(mmapPayloadLength));
+    appendI16(data, 24);
+    appendI16(data, 20);
+    appendI32(data, static_cast<std::uint32_t>(chunks.size()));
+    appendI32(data, static_cast<std::uint32_t>(chunks.size()));
+    appendI32(data, 0);
+    appendI32(data, 0);
+    appendI32(data, 0);
+    for (int index = 0; index < static_cast<int>(chunks.size()); ++index) {
+        appendI32(data, BinaryReader::fourCC(chunks[static_cast<std::size_t>(index)].first));
+        appendI32(data, static_cast<std::uint32_t>(chunks[static_cast<std::size_t>(index)].second.size()));
+        appendI32(data, static_cast<std::uint32_t>(offsets[static_cast<std::size_t>(index)]));
+        appendI16(data, 0);
+        appendI16(data, 0);
+        appendI32(data, 0);
+    }
+    for (const auto& chunk : chunks) {
+        data.insert(data.end(), chunk.second.begin(), chunk.second.end());
+    }
+    putI32At(data, 4, static_cast<std::uint32_t>(data.size() - 8));
+    return data;
+}
+
+void putHandlerRecord(std::vector<std::uint8_t>& scriptData, int offset, int nameId, int bytecodeOffset, int bytecodeLen) {
+    putI16At(scriptData, offset, nameId);
+    putI16At(scriptData, offset + 2, 0);
+    putI32At(scriptData, offset + 4, static_cast<std::uint32_t>(bytecodeLen));
+    putI32At(scriptData, offset + 8, static_cast<std::uint32_t>(bytecodeOffset));
+    putI16At(scriptData, offset + 12, 1);
+    putI32At(scriptData, offset + 14, 0);
+    putI16At(scriptData, offset + 18, 0);
+    putI32At(scriptData, offset + 20, 0);
+    putI16At(scriptData, offset + 24, 0);
+    putI32At(scriptData, offset + 26, 0);
+    putI32At(scriptData, offset + 30, 0);
+    putI16At(scriptData, offset + 34, 0);
+    putI16At(scriptData, offset + 36, 0);
+    putI32At(scriptData, offset + 38, 0);
+}
+
+void emitOpcodeU8(std::vector<std::uint8_t>& bytecode, int opcode, int arg) {
+    bytecode.push_back(static_cast<std::uint8_t>(opcode));
+    bytecode.push_back(static_cast<std::uint8_t>(arg));
+}
+
+void emitOpcodeU16(std::vector<std::uint8_t>& bytecode, int opcode, int arg) {
+    bytecode.push_back(static_cast<std::uint8_t>(opcode + 0x40));
+    bytecode.push_back(static_cast<std::uint8_t>((arg >> 8) & 0xFF));
+    bytecode.push_back(static_cast<std::uint8_t>(arg & 0xFF));
+}
+
+void emitOpcodeI32(std::vector<std::uint8_t>& bytecode, int opcode, std::uint32_t arg) {
+    bytecode.push_back(static_cast<std::uint8_t>(opcode + 0x80));
+    appendI32(bytecode, arg);
+}
+
+std::vector<std::uint8_t> buildHandlersBytecode(int secret1LiteralIndex) {
+    std::vector<std::uint8_t> bytecode;
+    emitOpcodeU8(bytecode, libreshockwave::lingo::code(Opcode::PUSH_CONS), secret1LiteralIndex * kLiteralScale);
+    bytecode.push_back(static_cast<std::uint8_t>(libreshockwave::lingo::code(Opcode::RET)));
+    return bytecode;
+}
+
+std::vector<std::uint8_t> buildTCodeBytecode(int secret2LiteralIndex,
+                                              int secret3LiteralIndex,
+                                              int floatKeyLiteralIndex,
+                                              int fallbackLiteralIndex) {
+    std::vector<std::uint8_t> bytecode;
+
+    emitOpcodeU8(bytecode, libreshockwave::lingo::code(Opcode::GET_PARAM), 0);
+    emitOpcodeU8(bytecode, libreshockwave::lingo::code(Opcode::PUSH_CONS), floatKeyLiteralIndex * kLiteralScale);
+    bytecode.push_back(static_cast<std::uint8_t>(libreshockwave::lingo::code(Opcode::EQ)));
+
+    const int jumpToIntCheckOffset = static_cast<int>(bytecode.size());
+    emitOpcodeU16(bytecode, libreshockwave::lingo::code(Opcode::JMP_IF_Z), 0);
+
+    emitOpcodeU8(bytecode, libreshockwave::lingo::code(Opcode::PUSH_CONS), secret2LiteralIndex * kLiteralScale);
+    bytecode.push_back(static_cast<std::uint8_t>(libreshockwave::lingo::code(Opcode::RET)));
+
+    const int intCheckStart = static_cast<int>(bytecode.size());
+    emitOpcodeU8(bytecode, libreshockwave::lingo::code(Opcode::GET_PARAM), 0);
+    emitOpcodeI32(bytecode, libreshockwave::lingo::code(Opcode::PUSH_INT32), static_cast<std::uint32_t>(kTCodeKey3));
+    bytecode.push_back(static_cast<std::uint8_t>(libreshockwave::lingo::code(Opcode::EQ)));
+
+    const int jumpToFallbackOffset = static_cast<int>(bytecode.size());
+    emitOpcodeU16(bytecode, libreshockwave::lingo::code(Opcode::JMP_IF_Z), 0);
+
+    emitOpcodeU8(bytecode, libreshockwave::lingo::code(Opcode::PUSH_CONS), secret3LiteralIndex * kLiteralScale);
+    bytecode.push_back(static_cast<std::uint8_t>(libreshockwave::lingo::code(Opcode::RET)));
+
+    const int fallbackStart = static_cast<int>(bytecode.size());
+    emitOpcodeU8(bytecode, libreshockwave::lingo::code(Opcode::PUSH_CONS), fallbackLiteralIndex * kLiteralScale);
+    bytecode.push_back(static_cast<std::uint8_t>(libreshockwave::lingo::code(Opcode::RET)));
+
+    putI16At(bytecode, jumpToIntCheckOffset + 1, intCheckStart - jumpToIntCheckOffset);
+    putI16At(bytecode, jumpToFallbackOffset + 1, fallbackStart - jumpToFallbackOffset);
+
+    return bytecode;
+}
+
+std::vector<std::uint8_t> buildScriptChunk(const Secrets& secrets) {
+    // Literal indices:
+    // 0 secret1, 1 secret2, 2 secret3, 3 float key, 4 fallback empty string
+    std::vector<std::uint8_t> literalData;
+    appendLiteralString(literalData, secrets.code1);
+    const int secret2Offset = static_cast<int>(literalData.size());
+    appendLiteralString(literalData, secrets.code2);
+    const int secret3Offset = static_cast<int>(literalData.size());
+    appendLiteralString(literalData, secrets.code3);
+    const int floatKeyOffset = static_cast<int>(literalData.size());
+    appendLiteralFloat(literalData, kTCodeKey2);
+    const int fallbackOffset = static_cast<int>(literalData.size());
+    appendLiteralString(literalData, "");
+
+    const auto handlersBytecode = buildHandlersBytecode(0);
+    const auto tCodeBytecode = buildTCodeBytecode(1, 2, 3, 4);
+
+    const int handlersBytecodeOffset = 512;
+    const int tCodeBytecodeOffset = handlersBytecodeOffset + static_cast<int>(handlersBytecode.size());
+    const int literalDataOffset = tCodeBytecodeOffset + static_cast<int>(tCodeBytecode.size()) + 16;
+
+    const int handlersRecordOffset = 110;
+    const int tCodeRecordOffset = 152;
+    const int literalInfoOffset = 194;
+
+    const int totalSize = literalDataOffset + static_cast<int>(literalData.size()) + 32;
+    std::vector<std::uint8_t> scriptData(static_cast<std::size_t>(totalSize), 0);
+
+    putI32At(scriptData, 8, static_cast<std::uint32_t>(totalSize));
+    putI32At(scriptData, 12, static_cast<std::uint32_t>(totalSize));
+    putI16At(scriptData, 16, 50);
+    putI16At(scriptData, 18, 9);
+    putI32At(scriptData, 38, 0x00000009);
+    putI16At(scriptData, 72, 2);
+    putI32At(scriptData, 74, handlersRecordOffset);
+    putI16At(scriptData, 78, 5);
+    putI32At(scriptData, 80, literalInfoOffset);
+    putI32At(scriptData, 84, static_cast<std::uint32_t>(literalData.size()));
+    putI32At(scriptData, 88, literalDataOffset);
+
+    putHandlerRecord(scriptData, handlersRecordOffset, 1, handlersBytecodeOffset,
+                     static_cast<int>(handlersBytecode.size()));
+    putHandlerRecord(scriptData, tCodeRecordOffset, 2, tCodeBytecodeOffset, static_cast<int>(tCodeBytecode.size()));
+
+    putI32At(scriptData, literalInfoOffset + 0, 1);
+    putI32At(scriptData, literalInfoOffset + 4, 0);
+    putI32At(scriptData, literalInfoOffset + 8, 1);
+    putI32At(scriptData, literalInfoOffset + 12, secret2Offset);
+    putI32At(scriptData, literalInfoOffset + 16, 1);
+    putI32At(scriptData, literalInfoOffset + 20, secret3Offset);
+    putI32At(scriptData, literalInfoOffset + 24, 9);
+    putI32At(scriptData, literalInfoOffset + 28, floatKeyOffset);
+    putI32At(scriptData, literalInfoOffset + 32, 1);
+    putI32At(scriptData, literalInfoOffset + 36, fallbackOffset);
+
+    std::memcpy(scriptData.data() + handlersBytecodeOffset, handlersBytecode.data(), handlersBytecode.size());
+    std::memcpy(scriptData.data() + tCodeBytecodeOffset, tCodeBytecode.data(), tCodeBytecode.size());
+    std::memcpy(scriptData.data() + literalDataOffset, literalData.data(), literalData.size());
+
+    return scriptData;
+}
+
+std::vector<std::uint8_t> buildNamesChunk() {
+    std::vector<std::uint8_t> namesData(20, 0);
+    putI16At(namesData, 16, 20);
+    putI16At(namesData, 18, 3);
+    appendPascal(namesData, "");
+    appendPascal(namesData, "handlers");
+    appendPascal(namesData, "tCode");
+    return namesData;
+}
+
+std::vector<std::uint8_t> buildConfigChunk() {
+    std::vector<std::uint8_t> configData(80, 0);
+    putI16At(configData, 36, kDirectorVersion);
+    return configData;
+}
+
+std::vector<std::uint8_t> buildCastIndexChunk(int castMemberChunkId) {
+    std::vector<std::uint8_t> castData;
+    appendI32(castData, static_cast<std::uint32_t>(castMemberChunkId));
+    return castData;
+}
+
+std::vector<std::uint8_t> buildScriptMemberChunk(int scriptChunkId) {
+    std::vector<std::uint8_t> info;
+    appendI32(info, 20);
+    appendI32(info, 0);
+    appendI32(info, 0);
+    appendI32(info, 0);
+    appendI32(info, static_cast<std::uint32_t>(scriptChunkId));
+    appendI16(info, 3);
+    appendI32(info, 0);
+    appendI32(info, 0);
+    appendI32(info, 15);
+    appendI32(info, 15);
+    appendPascal(info, "CSpecialScript");
+
+    std::vector<std::uint8_t> specific;
+    appendI16(specific, 2);
+
+    std::vector<std::uint8_t> data;
+    appendI32(data, static_cast<std::uint32_t>(libreshockwave::cast::code(MemberType::Script)));
+    appendI32(data, static_cast<std::uint32_t>(info.size()));
+    appendI32(data, static_cast<std::uint32_t>(specific.size()));
+    data.insert(data.end(), info.begin(), info.end());
+    data.insert(data.end(), specific.begin(), specific.end());
+    return data;
+}
+
+std::vector<std::uint8_t> buildGetSecCast(const Secrets& secrets) {
+    // Chunk ids by mmap order:
+    // 0 DRCF, 1 Lnam, 2 Lscr, 3 CAS*, 4 CASt
+    constexpr int kScriptChunkId = 2;
+    constexpr int kCastMemberChunkId = 4;
+
+    return buildRifx({{"DRCF", buildConfigChunk()},
+                      {"Lnam", buildNamesChunk()},
+                      {"Lscr", buildScriptChunk(secrets)},
+                      {"CAS*", buildCastIndexChunk(kCastMemberChunkId)},
+                      {"CASt", buildScriptMemberChunk(kScriptChunkId)}});
+}
+
+bool verifyCast(const std::vector<std::uint8_t>& data) {
+    auto file = DirectorFile::load(data);
+    if (!file) {
+        std::cerr << "verify: DirectorFile::load failed\n";
+        return false;
+    }
+    if (file->castMembers().empty()) {
+        std::cerr << "verify: no cast members\n";
+        return false;
+    }
+    const auto* member = file->castMembers().front().get();
+    if (member->name() != "CSpecialScript") {
+        std::cerr << "verify: member name is '" << member->name() << "'\n";
+        return false;
+    }
+    if (file->scripts().empty()) {
+        std::cerr << "verify: no scripts\n";
+        return false;
+    }
+    const auto& script = file->scripts().front();
+    const auto* handlers = script->findHandlerPtr("handlers");
+    const auto* tCode = script->findHandlerPtr("tCode");
+    if (handlers == nullptr || tCode == nullptr) {
+        std::cerr << "verify: missing handlers or tCode\n";
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 4) {
+        std::cerr << "Usage: " << (argc > 0 ? argv[0] : "getsec_cast")
+                  << " <secret1> <secret2> <secret3> [output.cct]\n";
+        return 1;
+    }
+
+    const Secrets secrets{argv[1], argv[2], argv[3]};
+    const auto castData = buildGetSecCast(secrets);
+    if (!verifyCast(castData)) {
+        std::cerr << "Built cast failed self-check\n";
+        return 2;
+    }
+
+    if (argc >= 5) {
+        std::ofstream out(argv[4], std::ios::binary);
+        if (!out) {
+            std::cerr << "Failed to open output: " << argv[4] << '\n';
+            return 3;
+        }
+        out.write(reinterpret_cast<const char*>(castData.data()), static_cast<std::streamsize>(castData.size()));
+        std::cerr << "Wrote " << castData.size() << " bytes to " << argv[4] << '\n';
+        return 0;
+    }
+
+    std::cout.write(reinterpret_cast<const char*>(castData.data()), static_cast<std::streamsize>(castData.size()));
+    return 0;
+}
