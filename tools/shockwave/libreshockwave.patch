+[[nodiscard]] std::string jsonEscape(std::string_view value) {
+    std::string out;
+    for (const char ch : value) {
+        switch (ch) {
+            case '"': out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\n': out += "\\n"; break;
+            case '\r': out += "\\r"; break;
+            case '\t': out += "\\t"; break;
+            default:
+                if (static_cast<unsigned char>(ch) < 0x20U) {
+                    out.push_back(' ');
+                } else {
+                    out.push_back(ch);
+                }
+        }
+    }
+    return out;
+}
+
+/**
+ * Resolves a film loop sub-sprite's member the way the PLAYER does.
+ *
+ * Copied deliberately from `SpriteBaker::resolveFilmLoopMember` rather than
+ * reinvented: a score names its sprites by (castLib, memberNumber), and 0 and
+ * 0xFFFF both mean "this movie's own lib", which is only discoverable from that
+ * function. Getting it wrong silently drops frames instead of failing.
+ */
+[[nodiscard]] std::shared_ptr<CastMemberChunk> filmLoopMember(
+    DirectorFile& file,
+    int castLib,
+    int memberNumber) {
+    auto member = file.getCastMemberByNumber(castLib, memberNumber);
+    if (member == nullptr && (castLib == 0xFFFF || castLib == 0)) {
+        member = file.getCastMemberByNumber(1, memberNumber);
+    }
+    if (member == nullptr) {
+        member = file.getCastMemberByIndex(castLib, memberNumber);
+        if (member == nullptr && (castLib == 0xFFFF || castLib == 0)) {
+            member = file.getCastMemberByIndex(1, memberNumber);
+        }
+    }
+    return member;
+}
+
+/**
+ * ⚠ A FILM LOOP IS A SCORE, NOT A PICTURE.
+ *
+ * `noblink_loop` (the nautilus squid), `shootingstar`, `SpaceRocket` and the
+ * rest are `filmLoop` members whose content is an SCVW chunk — a miniature
+ * score that sequences OTHER members. Nothing in the extractor wrote one,
+ * because `rawBytes()` only understands Raw/Bitmap/Sound/Media/Text and an SCVW
+ * deserialises to `ScoreChunk`, so it returned nullopt and the member was
+ * skipped entirely. The frame bitmaps came out fine; only the thing that orders
+ * them was lost, which is why the props were simply absent from their rooms.
+ *
+ * The score is reached with `getScoreForMember`, NOT the KEY* walk the rest of
+ * this loop uses — `getLinkedChunksForMember` finds links the plain key-table
+ * lookup misses, which is exactly why these three members looked chunkless.
+ *
+ * Semantics below follow `SpriteBaker::bakeFileBackedFilmLoop`, the player's
+ * own implementation:
+ *
+ *   - entries are matched by EXACT `frameIndex`, not accumulated as deltas;
+ *   - painting order is ascending `channelIndex`;
+ *   - `spriteType == 0` or `castMember <= 0` is an empty cell, skipped;
+ *   - a sub-sprite sits at `pos - registrationPoint - loopRect.topLeft`.
+ *
+ * The last subtraction is left to the CONSUMER: it already carries every
+ * member's registration point (`reg_x`/`reg_y` in this manifest) and applying it
+ * in one place keeps a single definition of where a bitmap's origin is. What is
+ * emitted here is the authored `posX`/`posY` plus the loop's own rect.
+ */
+[[nodiscard]] std::optional<fs::path> writeFilmLoop(
+    DirectorFile& file,
+    const std::shared_ptr<CastMemberChunk>& member,
+    const fs::path& dir,
+    const std::string& stem) {
+    using libreshockwave::chunks::ScoreChunk;
+
+    auto score = file.getScoreForMember(member);
+    if (score == nullptr || score->frameData().frameChannelData.empty()) {
+        return std::nullopt;
+    }
+
+    const auto info = libreshockwave::cast::FilmLoopInfo::parse(member->specificData());
+
+    std::map<int, std::vector<const ScoreChunk::FrameChannelEntry*>> byFrame;
+    int lastFrame = 0;
+    for (const auto& entry : score->frameData().frameChannelData) {
+        if (entry.data.isEmpty() || entry.data.spriteType == 0 || entry.data.castMember <= 0) {
+            continue;
+        }
+        const int frame = entry.frameIndex.value();
+        byFrame[frame].push_back(&entry);
+        lastFrame = std::max(lastFrame, frame);
+    }
+    if (byFrame.empty()) {
+        return std::nullopt;
+    }
+
+    // The header is authoritative when present; a score whose entries run past
+    // it (or which reports none) still has to play every frame it actually has.
+    const int frameCount = std::max(score->frameData().header.frameCount, lastFrame + 1);
+
+    std::ostringstream out;
+    out << "{\n";
+    out << "  \"name\": \"" << jsonEscape(member->name()) << "\",\n";
+    out << "  \"frameCount\": " << frameCount << ",\n";
+    out << "  \"width\": " << info.width() << ",\n";
+    out << "  \"height\": " << info.height() << ",\n";
+    out << "  \"rectLeft\": " << info.rectLeft << ",\n";
+    out << "  \"rectTop\": " << info.rectTop << ",\n";
+    out << "  \"regX\": " << info.regX() << ",\n";
+    out << "  \"regY\": " << info.regY() << ",\n";
+    out << "  \"loops\": " << (info.loops ? "true" : "false") << ",\n";
+    out << "  \"frames\": {\n";
+
+    bool firstFrame = true;
+    for (auto& frame : byFrame) {
+        auto& cells = frame.second;
+        std::sort(cells.begin(), cells.end(), [](const auto* left, const auto* right) {
+            return left->channelIndex.value() < right->channelIndex.value();
+        });
+
+        if (!firstFrame) {
+            out << ",\n";
+        }
+        firstFrame = false;
+        out << "    \"" << frame.first << "\": [";
+
+        bool firstCell = true;
+        for (const auto* cell : cells) {
+            const auto& data = cell->data;
+            auto sub = filmLoopMember(file, data.castLib, data.castMember);
+            if (sub == nullptr || sub->name().empty()) {
+                // Unnamed or unresolved: the consumer addresses members by name,
+                // so a cell it cannot name is not something it can draw.
+                continue;
+            }
+            if (!firstCell) {
+                out << ", ";
+            }
+            firstCell = false;
+            out << "{\"channel\": " << cell->channelIndex.value()
+                << ", \"member\": \"" << jsonEscape(sub->name()) << "\""
+                << ", \"posX\": " << data.posX
+                << ", \"posY\": " << data.posY
+                << ", \"width\": " << data.width
+                << ", \"height\": " << data.height
+                << ", \"ink\": " << data.ink
+                << ", \"blend\": " << data.blendByte
+                << ", \"flipH\": " << (data.isFlipH() ? 1 : 0)
+                << ", \"flipV\": " << (data.isFlipV() ? 1 : 0)
+                << "}";
+        }
+        out << "]";
+    }
+
+    out << "\n  }\n}\n";
+
+    const auto asset = dir / (stem + ".filmloop.json");
+    writeText(asset, out.str());
+    return asset;
+}
