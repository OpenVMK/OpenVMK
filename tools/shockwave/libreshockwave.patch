+// Duration from the first MPEG audio frame header, assuming CBR -- which every
+// VMK sound is. Returns 0 when no frame header can be found, so the caller can
+// fall back rather than report a confidently wrong number.
+double SoundChunk::estimateMp3DurationSeconds() const {
+    static constexpr int kBitrateV1L3[16] = {0,  32, 40, 48,  56,  64,  80,  96,
+                                             112, 128, 160, 192, 224, 256, 320, 0};
+    static constexpr int kBitrateV2L3[16] = {0,  8,  16, 24, 32, 40, 48, 56,
+                                             64, 80, 96, 112, 128, 144, 160, 0};
+    static constexpr int kSampleRateV1[4] = {44100, 48000, 32000, 0};
+
+    const auto& data = audioData_;
+    // Skip an ID3v2 tag if present; its header carries a syncsafe size.
+    std::size_t pos = 0;
+    if (data.size() > 10 && data[0] == 'I' && data[1] == 'D' && data[2] == '3') {
+        const std::size_t tagSize = (static_cast<std::size_t>(data[6] & 0x7F) << 21) |
+                                    (static_cast<std::size_t>(data[7] & 0x7F) << 14) |
+                                    (static_cast<std::size_t>(data[8] & 0x7F) << 7) |
+                                    static_cast<std::size_t>(data[9] & 0x7F);
+        pos = 10 + tagSize;
+    }
+
+    for (; pos + 3 < data.size(); ++pos) {
+        if (data[pos] != 0xFF || (data[pos + 1] & 0xE0) != 0xE0) {
+            continue;
+        }
+        const int versionBits = (data[pos + 1] >> 3) & 0x03;  // 3 = MPEG1, 2 = MPEG2
+        const int layerBits = (data[pos + 1] >> 1) & 0x03;    // 1 = Layer III
+        const int bitrateIndex = (data[pos + 2] >> 4) & 0x0F;
+        const int sampleRateIndex = (data[pos + 2] >> 2) & 0x03;
+        if (versionBits == 1 || layerBits == 0 || bitrateIndex == 0 || bitrateIndex == 15 ||
+            sampleRateIndex == 3) {
+            continue;
+        }
+
+        const bool isVersion1 = versionBits == 3;
+        const int bitrateKbps = isVersion1 ? kBitrateV1L3[bitrateIndex] : kBitrateV2L3[bitrateIndex];
+        int rate = kSampleRateV1[sampleRateIndex];
+        if (!isVersion1) {
+            rate /= (versionBits == 2) ? 2 : 4;  // MPEG2 halves, MPEG2.5 quarters
+        }
+        if (bitrateKbps <= 0 || rate <= 0) {
+            continue;
+        }
+        const auto payloadBytes = static_cast<double>(data.size() - pos);
+        return payloadBytes * 8.0 / (bitrateKbps * 1000.0);
+    }
+    return 0.0;
+}
