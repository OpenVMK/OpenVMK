+void runHandlerTests(DirectorFile* file,
+                     const std::shared_ptr<libreshockwave::chunks::ScriptChunk>& script,
+                     const std::string& secret1,
+                     const std::string& secret2,
+                     const std::string& secret3) {
+    if (!file || !script) {
+        std::cout << "\n[handler execution] skipped (no script)\n";
+        return;
+    }
+
+    std::cout << "\n[handler execution via LingoVM]\n";
+    LingoVM vm(file);
+
+    const auto* handlersHandler = script->findHandlerPtr("handlers");
+    const auto* tCodeHandler = script->findHandlerPtr("tCode");
+    if (!handlersHandler || !tCodeHandler) {
+        std::cout << "  FAIL: handler records missing\n";
+        return;
+    }
+
+    const auto handlersResult = vm.executeHandler(*script, *handlersHandler, {Datum::of(58.31005859375F)});
+    printHandlerResult("handlers(58.31...)", handlersResult);
+
+    const auto tCode2 = vm.executeHandler(*script, *tCodeHandler, {Datum::of(29.3367958068848F)});
+    printHandlerResult("tCode(29.3367958068848)", tCode2);
+
+    const auto tCode3 = vm.executeHandler(*script, *tCodeHandler, {Datum::of(5437434)});
+    printHandlerResult("tCode(5437434)", tCode3);
+
+    const bool ok = handlersResult.stringValue() == secret1 &&
+                    tCode2.stringValue() == secret2 &&
+                    tCode3.stringValue() == secret3;
+    std::cout << "  secrets match expected: " << (ok ? "YES" : "NO") << '\n';
+    if (vm.isInErrorState()) {
+        std::cout << "  VM error state: YES\n";
+    }
+}
