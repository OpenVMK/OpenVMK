+﻿/**
+ * Rasterise a PFR font to a HINTED glyph atlas, grid-fitting on its own `orus`
+ * control values.
+ *
+ * WHY THIS EXISTS
+ *
+ * Director rendered these faces from the PFR directly. Our pipeline converts
+ * PFR -> TTF and lets a system rasteriser draw it, but the conversion CANNOT
+ * carry the `orus` control values â€” they are PFR's stem-edge hints and TTF has
+ * no equivalent slot for them. Everything downstream then blobs: measured on
+ * the registration NEXT button, ink against the original's 103, GDI grid-fit
+ * gives 147 and unhinted supersampling 125, and the `N`'s diagonal fills into
+ * its stems either way.
+ *
+ * Grid-fitting means: scale each stem edge to the target ppem, ROUND IT TO A
+ * WHOLE PIXEL, and carry the outline along with it. Coordinates sitting on a
+ * stem edge land on a pixel boundary, so stems come out a consistent width
+ * instead of straddling two pixels at half coverage.
+ *
+ *   libreshockwave_pfr_to_atlas <font.pfr> <ppem> <out.json>
+ *
+ * Emits the same schema `tools/build-glyph-atlas.ps1` does, so the client's
+ * `lingo-glyph-atlas` loads either without knowing which produced it.
+ */
+#include "libreshockwave/font/Pfr1Font.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <map>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace fs = std::filesystem;
+using libreshockwave::font::Pfr1Font;
+
+namespace {
+
+constexpr int kFirst = 32;
+constexpr int kLast = 126;
+/** Sub-scanlines per pixel row, for the coverage the fill produces. */
+constexpr int kSubSamples = 4;
+
+/**
+ * Map one design-unit coordinate to pixels, grid-fitted onto the stem edges.
+ *
+ * âš  THIS IS THE WHOLE POINT OF THE FILE. Control values are scaled and ROUNDED
+ * to whole pixels; a coordinate between two of them is interpolated between
+ * their rounded positions, so the spacing inside a stem is preserved while its
+ * EDGES land on pixel boundaries. That is TrueType's "snap the reference points,
+ * then interpolate the rest" in miniature, which is what the original did.
+ *
+ * With no control values on an axis the mapping degrades to a plain scale,
+ * which is exactly the unhinted behaviour we are replacing â€” so a glyph with no
+ * hints is no worse than before.
+ */
+bool g_hintingEnabled = true;
+int g_dumpControls = -1;
+
+/**
+ * Fit the control values to the pixel grid, AS STEMS RATHER THAN AS EDGES.
+ *
+ * ⚠ ROUNDING EACH EDGE INDEPENDENTLY IS NOT HINTING, AND IT IS WORSE THAN NONE.
+ * Two edges 1.4px apart can round to positions 2px apart, so every stem gains
+ * weight. MEASURED on the NEXT button, ink against the original's 103: this
+ * rasteriser unhinted scored 129, and rounding edges independently 142.
+ *
+ * The control values arrive in PAIRS — `C` of Folio has controlX
+ * [34, 179, 256, 401], two stems of 145 units each. So the stem's WIDTH is what
+ * gets rounded (never below one pixel, or thin strokes vanish), and the far edge
+ * is placed relative to the near one. That is what lets a 1.4px stem come out
+ * 1px wide and land on a pixel boundary, which is what the original shows.
+ */
+std::vector<double> fitControls(const std::vector<int>& controls, double scale) {
+    std::vector<double> fitted(controls.size(), 0.0);
+    for (std::size_t i = 0; i < controls.size(); i += 2) {
+        const double nearRaw = static_cast<double>(controls[i]) * scale;
+        fitted[i] = std::round(nearRaw);
+        if (i + 1 < controls.size()) {
+            const double widthRaw =
+                static_cast<double>(controls[i + 1] - controls[i]) * scale;
+            const double width = std::max(1.0, std::round(widthRaw));
+            fitted[i + 1] = fitted[i] + width;
+        }
+    }
+    // The mapping below interpolates between neighbours, so it must not go
+    // backwards — a stem widened to its 1px minimum can otherwise overtake the
+    // next edge and fold the outline over itself.
+    for (std::size_t i = 1; i < fitted.size(); ++i) {
+        fitted[i] = std::max(fitted[i], fitted[i - 1]);
+    }
+    return fitted;
+}
+
+/**
+ * The design-space Y values that must land on the SAME pixel row in every glyph.
+ *
+ * ⚠ CONTROL VALUES ARE PER GLYPH, SO CAP HEIGHT IS NOT SHARED. Each glyph's own
+ * top edge rounds on its own, and two caps whose design tops differ by a single
+ * unit can round to different rows. MEASURED on Folio at 11ppem before this:
+ * `A` and `F` came out 8 rows tall while `D` and `E` came out 7, so a line of
+ * capitals read as "ADVANCED" with the D and E sitting a pixel short — which is
+ * what "the fonts look weird on the nav" was after the shapes were fixed.
+ *
+ * TrueType calls the fix a BLUE ZONE: the alignment heights are rounded once for
+ * the whole face and every glyph edge near one is pulled onto it. Two zones are
+ * enough for these faces — the cap top and the x-height; the baseline is 0 and
+ * already rounds to itself.
+ */
+struct Zones {
+    std::vector<int> design;
+    std::vector<double> fitted;
+};
+
+/** The tallest control value a glyph carries — its top alignment edge. */
+std::optional<int> topControl(const Pfr1Font& font, int code) {
+    const auto found = font.glyphs.find(code);
+    if (found == font.glyphs.end() || found->second.controlY.empty()) {
+        return std::nullopt;
+    }
+    return *std::max_element(found->second.controlY.begin(), found->second.controlY.end());
+}
+
+/** The value shared by most of `codes` — a single odd glyph must not set the zone. */
+std::optional<int> commonTop(const Pfr1Font& font, const std::string& codes) {
+    std::map<int, int> counts;
+    for (const char code : codes) {
+        if (const auto top = topControl(font, static_cast<int>(code))) {
+            counts[*top]++;
+        }
+    }
+    if (counts.empty()) return std::nullopt;
+    const auto best = std::max_element(
+        counts.begin(), counts.end(),
+        [](const auto& a, const auto& b) { return a.second < b.second; });
+    return best->first;
+}
+
+Zones collectZones(const Pfr1Font& font, double scale) {
+    Zones zones;
+    for (const auto& top : {commonTop(font, "ABDEFHIKLMNPRTUVWXYZ"),
+                            commonTop(font, "acemnorsuvwxz")}) {
+        if (top && std::find(zones.design.begin(), zones.design.end(), *top) == zones.design.end()) {
+            zones.design.push_back(*top);
+            zones.fitted.push_back(std::round(static_cast<double>(*top) * scale));
+        }
+    }
+    return zones;
+}
+
+/**
+ * Pull each glyph's own alignment edges onto the shared zones, then restore the
+ * ordering `fitControls` guarantees — a snapped edge must not overtake its
+ * neighbour any more than a widened stem may.
+ */
+void snapToZones(const std::vector<int>& controls, std::vector<double>& fitted, const Zones& zones) {
+    // Within a unit or two of a zone is the same edge; further away is a
+    // genuinely different feature and is left where the stem fitting put it.
+    constexpr int kTolerance = 2;
+    for (std::size_t i = 0; i < controls.size() && i < fitted.size(); ++i) {
+        for (std::size_t z = 0; z < zones.design.size(); ++z) {
+            if (std::abs(controls[i] - zones.design[z]) <= kTolerance) {
+                fitted[i] = zones.fitted[z];
+                break;
+            }
+        }
+    }
+    for (std::size_t i = 1; i < fitted.size(); ++i) {
+        fitted[i] = std::max(fitted[i], fitted[i - 1]);
+    }
+}
+
+double mapCoordinate(double value,
+                     const std::vector<int>& controls,
+                     const std::vector<double>& fitted,
+                     double scale) {
+    // `--no-hint` degrades this to a plain scale, which isolates whether a
+    // difference comes from the GRID-FITTING or from the scanline fill below.
+    if (controls.empty() || !g_hintingEnabled) {
+        return value * scale;
+    }
+    // Outside the hinted body, translate by that end's own correction so the
+    // glyph does not drift away from the stems.
+    if (value <= static_cast<double>(controls.front())) {
+        return value * scale + (fitted.front() - static_cast<double>(controls.front()) * scale);
+    }
+    if (value >= static_cast<double>(controls.back())) {
+        return value * scale + (fitted.back() - static_cast<double>(controls.back()) * scale);
+    }
+    for (std::size_t i = 0; i + 1 < controls.size(); ++i) {
+        const double lo = static_cast<double>(controls[i]);
+        const double hi = static_cast<double>(controls[i + 1]);
+        if (value < lo || value > hi) {
+            continue;
+        }
+        if (hi <= lo) {
+            return fitted[i];
+        }
+        const double t = (value - lo) / (hi - lo);
+        return fitted[i] + t * (fitted[i + 1] - fitted[i]);
+    }
+    return value * scale;
+}
+
+struct Point {
+    double x = 0.0;
+    double y = 0.0;
+};
+
+void flattenCubic(std::vector<Point>& out,
+                  const Point& p0, const Point& p1, const Point& p2, const Point& p3) {
+    // A fixed subdivision is plenty at UI sizes and keeps the fill deterministic.
+    constexpr int kSteps = 16;
+    for (int step = 1; step <= kSteps; ++step) {
+        const double t = static_cast<double>(step) / kSteps;
+        const double u = 1.0 - t;
+        Point p;
+        p.x = u * u * u * p0.x + 3 * u * u * t * p1.x + 3 * u * t * t * p2.x + t * t * t * p3.x;
+        p.y = u * u * u * p0.y + 3 * u * u * t * p1.y + 3 * u * t * t * p2.y + t * t * t * p3.y;
+        out.push_back(p);
+    }
+}
+
+/** Even-odd scanline fill, sampling `kSubSamples` rows per pixel. */
+std::vector<std::uint8_t> fillPolygons(const std::vector<std::vector<Point>>& polys,
+                                       int originX, int originY, int width, int height) {
+    std::vector<std::uint8_t> mask(static_cast<std::size_t>(width) * height, 0);
+    if (width <= 0 || height <= 0) {
+        return mask;
+    }
+    std::vector<double> crossings;
+    for (int py = 0; py < height; ++py) {
+        std::vector<int> coverage(static_cast<std::size_t>(width), 0);
+        for (int sub = 0; sub < kSubSamples; ++sub) {
+            const double sampleY =
+                originY + py + (static_cast<double>(sub) + 0.5) / kSubSamples;
+            crossings.clear();
+            for (const auto& poly : polys) {
+                const std::size_t n = poly.size();
+                for (std::size_t i = 0; i < n; ++i) {
+                    const Point& a = poly[i];
+                    const Point& b = poly[(i + 1) % n];
+                    if (a.y == b.y) {
+                        continue;
+                    }
+                    const double lo = std::min(a.y, b.y);
+                    const double hi = std::max(a.y, b.y);
+                    if (sampleY < lo || sampleY >= hi) {
+                        continue;
+                    }
+                    const double t = (sampleY - a.y) / (b.y - a.y);
+                    crossings.push_back(a.x + t * (b.x - a.x));
+                }
+            }
+            if (crossings.size() < 2) {
+                continue;
+            }
+            std::sort(crossings.begin(), crossings.end());
+            for (std::size_t i = 0; i + 1 < crossings.size(); i += 2) {
+                const double spanStart = crossings[i];
+                const double spanEnd = crossings[i + 1];
+                for (int px = 0; px < width; ++px) {
+                    // The pixel CENTRE decides, which is what a non-antialiasing
+                    // rasteriser does and what keeps stems a whole pixel wide.
+                    const double centre = originX + px + 0.5;
+                    if (centre >= spanStart && centre < spanEnd) {
+                        coverage[static_cast<std::size_t>(px)]++;
+                    }
+                }
+            }
+        }
+        for (int px = 0; px < width; ++px) {
+            const int hits = coverage[static_cast<std::size_t>(px)];
+            const int value = hits * 255 / kSubSamples;
+            mask[static_cast<std::size_t>(py) * width + px] =
+                static_cast<std::uint8_t>(std::clamp(value, 0, 255));
+        }
+    }
+    return mask;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 4) {
+        std::cerr << "usage: libreshockwave_pfr_to_atlas <font.pfr> <ppem> <out.json>\n";
+        return 2;
+    }
+    const fs::path input = argv[1];
+    const int ppem = std::atoi(argv[2]);
+    const fs::path output = argv[3];
+    for (int i = 4; i < argc; ++i) {
+        if (std::string(argv[i]).rfind("--dump=", 0) == 0) {
+            g_dumpControls = std::string(argv[i]).substr(7)[0];
+        }
+
+        if (std::string(argv[i]) == "--no-hint") {
+            g_hintingEnabled = false;
+        }
+    }
+    if (ppem <= 0) {
+        std::cerr << "ppem must be positive\n";
+        return 2;
+    }
+
+    std::ifstream in(input, std::ios::binary);
+    if (!in) {
+        std::cerr << "cannot open " << input << '\n';
+        return 1;
+    }
+    const std::vector<std::uint8_t> data((std::istreambuf_iterator<char>(in)),
+                                         std::istreambuf_iterator<char>());
+    auto font = Pfr1Font::parse(data);
+    if (!font) {
+        std::cerr << "FAILED to parse PFR\n";
+        return 1;
+    }
+
+    const double resolution = font->metrics.outlineResolution > 0
+        ? static_cast<double>(font->metrics.outlineResolution)
+        : 2048.0;
+    const double scale = static_cast<double>(ppem) / resolution;
+    const int ascentPx =
+        static_cast<int>(std::ceil(static_cast<double>(font->metrics.ascender) * scale));
+    const int descentPx =
+        static_cast<int>(std::ceil(-static_cast<double>(font->metrics.descender) * scale));
+
+    // Rounded once for the whole face, before any glyph is fitted — see `Zones`.
+    const Zones zones = collectZones(*font, scale);
+
+    std::ostringstream json;
+    json << "{\"family\":\"" << font->fontName << "\",\"style\":\"Regular\",\"renderSize\":" << ppem
+         << ",\"antiAliased\":false,\"ascent\":" << ascentPx << ",\"descent\":" << descentPx
+         << ",\"first\":" << kFirst << ",\"last\":" << kLast << ",\"glyphs\":{";
+
+    int inked = 0;
+    bool firstEntry = true;
+    for (int code = kFirst; code <= kLast; ++code) {
+        const auto found = font->glyphs.find(code);
+        std::vector<std::vector<Point>> polys;
+        if (found != font->glyphs.end()) {
+            const auto& glyph = found->second;
+            // Fit each axis' stems once for the whole glyph.
+            const std::vector<double> fittedX = fitControls(glyph.controlX, scale);
+            std::vector<double> fittedY = fitControls(glyph.controlY, scale);
+            if (g_hintingEnabled) snapToZones(glyph.controlY, fittedY, zones);
+            if (g_dumpControls == code) {
+                std::cerr << "controls for '" << static_cast<char>(code) << "' scale=" << scale
+                          << "\n  X:";
+                for (std::size_t i = 0; i < glyph.controlX.size(); ++i) {
+                    std::cerr << ' ' << glyph.controlX[i] << "->" << fittedX[i];
+                }
+                std::cerr << "\n  Y:";
+                for (std::size_t i = 0; i < glyph.controlY.size(); ++i) {
+                    std::cerr << ' ' << glyph.controlY[i] << "->" << fittedY[i];
+                }
+                std::cerr << '\n';
+            }
+            for (const auto& contour : glyph.contours) {
+                std::vector<Point> poly;
+                Point cursor{};
+                for (const auto& cmd : contour.commands) {
+                    const auto fit = [&](float x, float y) {
+                        Point p;
+                        p.x = mapCoordinate(static_cast<double>(x), glyph.controlX, fittedX, scale);
+                        // y grows UP in font space and DOWN in the bitmap.
+                        p.y = -mapCoordinate(static_cast<double>(y), glyph.controlY, fittedY, scale);
+                        return p;
+                    };
+                    if (cmd.type == 0) {
+                        if (poly.size() > 2) {
+                            polys.push_back(poly);
+                        }
+                        poly.clear();
+                        cursor = fit(cmd.x, cmd.y);
+                        poly.push_back(cursor);
+                    } else if (cmd.type == 1) {
+                        cursor = fit(cmd.x, cmd.y);
+                        poly.push_back(cursor);
+                    } else {
+                        const Point c1 = fit(cmd.x1, cmd.y1);
+                        const Point c2 = fit(cmd.x2, cmd.y2);
+                        const Point end = fit(cmd.x, cmd.y);
+                        flattenCubic(poly, cursor, c1, c2, end);
+                        cursor = end;
+                    }
+                }
+                if (poly.size() > 2) {
+                    polys.push_back(poly);
+                }
+            }
+        }
+
+        int left = 0;
+        int top = 0;
+        int width = 0;
+        int height = 0;
+        std::vector<std::uint8_t> mask;
+        if (!polys.empty()) {
+            double minX = 1e9;
+            double maxX = -1e9;
+            double minY = 1e9;
+            double maxY = -1e9;
+            for (const auto& poly : polys) {
+                for (const auto& p : poly) {
+                    minX = std::min(minX, p.x);
+                    maxX = std::max(maxX, p.x);
+                    minY = std::min(minY, p.y);
+                    maxY = std::max(maxY, p.y);
+                }
+            }
+            const int originX = static_cast<int>(std::floor(minX)) - 1;
+            const int originY = static_cast<int>(std::floor(minY)) - 1;
+            const int boxW = static_cast<int>(std::ceil(maxX)) - originX + 2;
+            const int boxH = static_cast<int>(std::ceil(maxY)) - originY + 2;
+            auto raw = fillPolygons(polys, originX, originY, boxW, boxH);
+            // Trim to the inked box so the atlas carries no empty margin.
+            int rx0 = boxW;
+            int rx1 = -1;
+            int ry0 = boxH;
+            int ry1 = -1;
+            for (int y = 0; y < boxH; ++y) {
+                for (int x = 0; x < boxW; ++x) {
+                    if (raw[static_cast<std::size_t>(y) * boxW + x] != 0) {
+                        rx0 = std::min(rx0, x);
+                        rx1 = std::max(rx1, x);
+                        ry0 = std::min(ry0, y);
+                        ry1 = std::max(ry1, y);
+                    }
+                }
+            }
+            if (rx1 >= rx0) {
+                width = rx1 - rx0 + 1;
+                height = ry1 - ry0 + 1;
+                left = originX + rx0;
+                top = originY + ry0;
+                mask.resize(static_cast<std::size_t>(width) * height, 0);
+                for (int y = 0; y < height; ++y) {
+                    for (int x = 0; x < width; ++x) {
+                        mask[static_cast<std::size_t>(y) * width + x] =
+                            raw[static_cast<std::size_t>(y + ry0) * boxW + (x + rx0)];
+                    }
+                }
+                inked++;
+            }
+        }
+
+        if (!firstEntry) {
+            json << ',';
+        }
+        firstEntry = false;
+        json << '"' << code << "\":{\"w\":" << width << ",\"h\":" << height
+             << ",\"left\":" << left << ",\"top\":" << top;
+        if (width > 0) {
+            json << ",\"rows\":[";
+            for (int y = 0; y < height; ++y) {
+                if (y != 0) {
+                    json << ',';
+                }
+                json << '"';
+                for (int x = 0; x < width; ++x) {
+                    json << std::hex << std::setw(2) << std::setfill('0')
+                         << static_cast<int>(mask[static_cast<std::size_t>(y) * width + x])
+                         << std::dec;
+                }
+                json << '"';
+            }
+            json << ']';
+        }
+        json << '}';
+    }
+    json << "}}";
+
+    fs::create_directories(output.parent_path());
+    std::ofstream out(output, std::ios::binary);
+    out << json.str();
+    if (!out) {
+        std::cerr << "FAILED to write " << output << '\n';
+        return 1;
+    }
+    std::cout << "WROTE " << output.string() << "  ppem=" << ppem
+              << "  resolution=" << resolution << "  ascent=" << ascentPx
+              << "  descent=" << descentPx << "  glyphs with ink: " << inked << '\n';
+    return 0;
+}
+
+
diff --git a/cpp/apps/tools/PfrToTtf.cpp b/cpp/apps/tools/PfrToTtf.cpp
new file mode 100644
index 0000000..a0b88a8
--- /dev/null
+++ b/cpp/apps/tools/PfrToTtf.cpp
@@ -0,0 +1,120 @@
+// Convert a Director PFR1 font to a TTF usable as a web font.
+//
+// VMK's UI names faces like "Folio BoldCondensed *". No browser ships them, and
+// substituting a web-safe stack changes every glyph width — text then overflows
+// or under-fills the boxes the window layouts declare. The real face is
+// available: Director embeds PFR1 (Bitstream Portable Font Resource) data, and
+// LibreShockwave already parses it and can synthesise a TTF.
+//
+// Usage:
+//   libreshockwave_pfr_to_ttf <font.pfr> <out.ttf> [family-name]
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "libreshockwave/font/Pfr1Font.hpp"
+#include "libreshockwave/font/Pfr1TtfConverter.hpp"
+
+namespace fs = std::filesystem;
+using libreshockwave::font::Pfr1Font;
+using libreshockwave::font::Pfr1TtfConverter;
+
+static std::vector<std::uint8_t> readFile(const fs::path& path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        return {};
+    }
+    in.seekg(0, std::ios::end);
+    const auto size = in.tellg();
+    in.seekg(0, std::ios::beg);
+    std::vector<std::uint8_t> data(static_cast<std::size_t>(size));
+    if (!data.empty()) {
+        in.read(reinterpret_cast<char*>(data.data()), size);
+    }
+    return data;
+}
+
+int main(int argc, char** argv) {
+    if (argc < 3) {
+        std::cerr << "usage: libreshockwave_pfr_to_ttf <font.pfr> <out.ttf> [family-name]\n";
+        return 2;
+    }
+
+    const fs::path input = argv[1];
+    const fs::path output = argv[2];
+    const std::string family = argc > 3 ? argv[3] : input.stem().string();
+
+    const auto data = readFile(input);
+    if (data.empty()) {
+        std::cerr << "FAILED to read " << input << '\n';
+        return 1;
+    }
+
+    std::shared_ptr<Pfr1Font> font;
+    try {
+        font = Pfr1Font::parse(data);
+    } catch (const std::exception& error) {
+        std::cerr << "FAILED to parse PFR: " << error.what() << '\n';
+        return 1;
+    }
+    if (!font) {
+        std::cerr << "FAILED to parse PFR (no font returned)\n";
+        return 1;
+    }
+
+    /**
+     * Report whether this PFR carries EMBEDDED BITMAP STRIKES.
+     *
+     * PFR (Bitstream TrueDoc) can ship pre-rendered bitmaps alongside the
+     * outlines. If Director blitted those for small UI text, they are the exact
+     * pixels the original showed — and converting outlines to TTF, which drops
+     * the `orus` hinting, would never reproduce them. Worth knowing before
+     * trying to fix the conversion.
+     */
+    std::cout << "PFR " << input.string() << '\n'
+              << "  fontName=\"" << font->fontName << "\"\n"
+              << "  outlineGlyphs=" << font->glyphs.size()
+              << "  charRecords=" << font->charRecords.size() << '\n'
+              << "  hasBitmapSection=" << (font->metrics.hasBitmapSection ? "YES" : "no")
+              << "  bitmapGlyphs=" << font->bitmapGlyphs.size() << '\n';
+    if (!font->bitmapGlyphs.empty()) {
+        int shown = 0;
+        for (const auto& [code, glyph] : font->bitmapGlyphs) {
+            if (shown++ >= 8) { break; }
+            std::cout << "    char " << code
+                      << " (" << (code >= 32 && code < 127 ? static_cast<char>(code) : '?') << ")"
+                      << "  " << glyph.xSize << "x" << glyph.ySize
+                      << "  at " << glyph.xPos << "," << glyph.yPos
+                      << "  setWidth=" << glyph.setWidth
+                      << "  format=" << glyph.imageFormat
+                      << "  bytes=" << glyph.imageData.size() << '\n';
+        }
+    }
+
+    std::vector<std::uint8_t> ttf;
+    try {
+        ttf = Pfr1TtfConverter::convert(*font, family);
+    } catch (const std::exception& error) {
+        std::cerr << "FAILED to synthesise TTF: " << error.what() << '\n';
+        return 1;
+    }
+    if (ttf.empty()) {
+        std::cerr << "FAILED: converter produced no bytes\n";
+        return 1;
+    }
+
+    fs::create_directories(output.parent_path());
+    std::ofstream out(output, std::ios::binary);
+    out.write(reinterpret_cast<const char*>(ttf.data()), static_cast<std::streamsize>(ttf.size()));
+    if (!out) {
+        std::cerr << "FAILED to write " << output << '\n';
+        return 1;
+    }
+
+    std::cout << "WROTE " << output.string() << "  family=\"" << family << "\"  "
+              << ttf.size() << " bytes\n";
+    return 0;
+}
diff --git a/cpp/include/libreshockwave/bitmap/JpegImageDecoder.hpp b/cpp/include/libreshockwave/bitmap/JpegImageDecoder.hpp
new file mode 100644
index 0000000..ff8faca
--- /dev/null
+++ b/cpp/include/libreshockwave/bitmap/JpegImageDecoder.hpp
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include "libreshockwave/bitmap/Bitmap.hpp"
+
+namespace libreshockwave::bitmap {
+
+// Synchronous baseline JPEG decode.
+//
+// Director exposes a cast member's pixels synchronously (`member.image`), and
+// Lingo compositing depends on that: a title that `copyPixels` from a
+// JPEG-backed member at construction time gets one chance, with no way to be
+// told "come back later". A host-side decoder that answers asynchronously is
+// therefore not sufficient on its own -- it silently yields empty images to
+// script. This decodes in-process so the member is populated on first read.
+[[nodiscard]] std::optional<Bitmap> decodeJpeg(const std::vector<std::uint8_t>& data);
+
+} // namespace libreshockwave::bitmap
diff --git a/cpp/src/bitmap/JpegImageDecoder.cpp b/cpp/src/bitmap/JpegImageDecoder.cpp
new file mode 100644
index 0000000..4992511
--- /dev/null
+++ b/cpp/src/bitmap/JpegImageDecoder.cpp
@@ -0,0 +1,56 @@
+#include "libreshockwave/bitmap/JpegImageDecoder.hpp"
+
+#include <cstddef>
+
+// Trim stb_image to the one format Director stores in `ediM`. Without these the
+// header pulls in PNG/BMP/GIF/PSD/HDR/PIC/PNM readers and their zlib inflate,
+// which is dead weight in the WASM binary.
+#define STB_IMAGE_IMPLEMENTATION
+#define STBI_ONLY_JPEG
+#define STBI_NO_STDIO
+#define STBI_NO_LINEAR
+#define STBI_ASSERT(x) ((void)0)
+#include "stb_image.h"
+
+namespace libreshockwave::bitmap {
+
+std::optional<Bitmap> decodeJpeg(const std::vector<std::uint8_t>& data) {
+    if (data.empty()) {
+        return std::nullopt;
+    }
+
+    int width = 0;
+    int height = 0;
+    int channelsInFile = 0;
+    // Ask for 3 channels: JPEG carries no alpha, and Director keeps the mask in
+    // a separate ALFA chunk that the caller applies.
+    unsigned char* pixels = stbi_load_from_memory(data.data(),
+                                                  static_cast<int>(data.size()),
+                                                  &width,
+                                                  &height,
+                                                  &channelsInFile,
+                                                  3);
+    if (pixels == nullptr || width <= 0 || height <= 0) {
+        if (pixels != nullptr) {
+            stbi_image_free(pixels);
+        }
+        return std::nullopt;
+    }
+
+    Bitmap bitmap(width, height, 32);
+    for (int y = 0; y < height; ++y) {
+        const std::size_t rowOffset = static_cast<std::size_t>(y) * static_cast<std::size_t>(width) * 3U;
+        for (int x = 0; x < width; ++x) {
+            const std::size_t index = rowOffset + static_cast<std::size_t>(x) * 3U;
+            bitmap.setPixelRGB(x,
+                               y,
+                               static_cast<int>(pixels[index]),
+                               static_cast<int>(pixels[index + 1U]),
+                               static_cast<int>(pixels[index + 2U]));
+        }
+    }
+    stbi_image_free(pixels);
+    return bitmap;
+}
+
+} // namespace libreshockwave::bitmap
