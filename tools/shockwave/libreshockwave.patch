+void testSystemPropsManagerClasses(CastLibManager& manager) {
+    std::cout << "\n[system props class lookup via builtins]\n";
+    BuiltinContext context;
+    manager.installBuiltinCallbacks(context);
+    BuiltinRegistry registry;
+
+    const Datum fieldDatum = context.fieldResolver(Datum::of("System Props"), 0);
+    printDatumSummary("field(System Props)", fieldDatum);
+
+    const Datum propList =
+        registry.invoke("convertToPropList", context, {fieldDatum, Datum::symbol("return")});
+    printDatumSummary("convertToPropList(..., RETURN)", propList);
+
+    const Datum objectClass = registry.invoke("getaProp", context, {propList, Datum::of("object.manager.class")});
+    printDatumSummary("getaProp(object.manager.class)", objectClass);
+
+    const Datum variableClassKey = registry.invoke("getaProp", context, {propList, Datum::of("variable.manager.class")});
+    printDatumSummary("getaProp(variable.manager.class)", variableClassKey);
+
+    if (propList.isPropList()) {
+        const Datum bracketKey(Datum::of("variable.manager.class"));
+        const int bracketIndex = propList.propListValue().findUntypedKey(bracketKey);
+        const Datum bracketClass = bracketIndex >= 0
+            ? propList.propListValue().properties()[static_cast<std::size_t>(bracketIndex)].second
+            : Datum::voidValue();
+        printDatumSummary("bracket(variable.manager.class via findUntypedKey)", bracketClass);
+    }
+
+    const Datum variableClassValue = registry.invoke("value", context, {variableClassKey});
+    printDatumSummary("value(variable.manager.class)", variableClassValue);
+
+    const Datum memberTManager = registry.invoke("member", context, {Datum::of("TManager")});
+    printDatumSummary("member(TManager)", memberTManager);
+    if (const auto* ref = memberTManager.asCastMemberRef()) {
+        const Datum numberProp = context.castMemberPropertyGetter(ref->castLib, ref->memberNum(), "number");
+        printDatumSummary("member(TManager).number", numberProp);
+    }
+
+    const Datum scriptCMgrObject = registry.invoke("script", context, {Datum::of("CMgrObject")});
+    printDatumSummary("script(CMgrObject)", scriptCMgrObject);
+
+    const Datum objectClassValue = registry.invoke("value", context, {objectClass});
+    printDatumSummary("value(object.manager.class)", objectClassValue);
+    if (objectClassValue.isList() && objectClassValue.listValue().count() >= 1) {
+        printDatumSummary("objectClass[1]", objectClassValue.listValue().getAt(1));
+    }
