+int main(int argc, char** argv) {
+    if (argc < 3) {
+        std::cerr << "Usage: " << (argc > 0 ? argv[0] : "getsec_probe")
+                  << " <host.dcr> <getsec.cct> [secret1 secret2 secret3]\n";
+        return 1;
+    }
+
+    const std::string hostPath = argv[1];
+    const std::string castPath = argv[2];
+    const std::string secret1 = argc > 3 ? argv[3] : "dev-secret-1";
+    const std::string secret2 = argc > 4 ? argv[4] : "dev-secret-2";
+    const std::string secret3 = argc > 5 ? argv[5] : "dev-secret-3";
+
+    const auto hostData = readFile(hostPath);
+    const auto castData = readFile(castPath);
+    if (hostData.empty()) {
+        std::cerr << "Failed to read host: " << hostPath << '\n';
+        return 2;
+    }
+    if (castData.empty()) {
+        std::cerr << "Failed to read cast: " << castPath << '\n';
+        return 3;
+    }
+
+    std::cout << "Host: " << hostPath << " (" << hostData.size() << " bytes)\n";
+    std::cout << "Cast: " << castPath << " (" << castData.size() << " bytes)\n";
+
+    printStandaloneCastDiagnostics(castData);
+
+    auto hostFile = DirectorFile::load(hostData);
+    if (!hostFile) {
+        std::cerr << "Failed to load host movie\n";
+        return 4;
+    }
+
+    CastLibManager manager(hostFile);
+    std::cout << "\n[host cast libs before injection]\n";
+    for (int i = 1; i <= 5; ++i) {
+        printCastLibSummary(manager, i);
+    }
+
+    std::cout << "\n[setExternalCastData(3, cast)]\n";
+    const bool injected = manager.setExternalCastData(3, castData);
+    std::cout << "  result: " << (injected ? "OK" : "FAIL") << '\n';
+    if (!injected) {
+        return 5;
+    }
+
+    std::cout << "\n[castLib(3) after injection]\n";
+    printCastLibSummary(manager, 3);
+
+    std::cout << "\n[member lookup]\n";
+    const char* probeNames[] = {"CSpecialScript", "TManager", "CMgrVariable", "CMgrObject", "System Props",
+                                "Special Services Class", "String Services Class", "Core Thread Class",
+                                "C0re Thread Class", "CMgrThread", "CMgrResource"};
+    const Datum::CastMemberRef* memberRef = nullptr;
+    int memberNum = -1;
+    for (const char* probeName : probeNames) {
+        const auto memberDatum = manager.getMemberByName(3, probeName);
+        const auto* ref = memberDatum.asCastMemberRef();
+        const auto globalMember = manager.findCastMemberByName(probeName);
+        std::cout << "  getMemberByName(3, " << probeName << "): "
+                  << (ref ? "found" : "NOT FOUND");
+        if (ref) {
+            std::cout << " memberNum=" << ref->memberNum() << " castLib=" << ref->castLib;
+            const auto numberProp = manager.getMemberProp(3, ref->memberNum(), "number");
+            std::cout << " .number=" << numberProp.intValue();
+        }
+        std::cout << " | global=" << (globalMember ? "found" : "NOT FOUND") << '\n';
+        if (std::string_view(probeName) == "CSpecialScript") {
+            if (ref) {
+                memberRef = ref;
+                memberNum = ref->memberNum();
+            } else if (globalMember) {
+                memberNum = globalMember->memberNum();
+            }
+        }
+    }
+
+    if (memberRef) {
+        std::cout << "  CSpecialScript memberNum=" << memberNum << " castLib=" << memberRef->castLib << '\n';
+        const auto memberNumProp = manager.getMemberProp(3, memberNum, "memberNum");
+        std::cout << "  prop memberNum=" << memberNumProp.intValue() << '\n';
+    } else if (memberNum > 0) {
+        std::cout << "  CSpecialScript global memberNum=" << memberNum << '\n';
+    }
+
+    std::shared_ptr<libreshockwave::chunks::ScriptChunk> runtimeScript;
+    if (memberNum > 0) {
+        if (const auto castLib = manager.getCastLib(3)) {
+            runtimeScript = castLib->getScript(memberNum);
+        }
+    }
+    std::cout << "  castLib(3)->getScript(memberNum): " << (runtimeScript ? "OK" : "NULL") << '\n';
+
+    DirectorFile* handlerFile = nullptr;
+    if (const auto castLib = manager.getCastLib(3)) {
+        if (const auto source = castLib->sourceFile()) {
+            handlerFile = source.get();
+        }
+    }
+    if (!runtimeScript && handlerFile) {
+        for (const auto& member : handlerFile->castMembers()) {
+            if (member && member->name() == "CSpecialScript") {
+                runtimeScript = handlerFile->getScriptForCastMember(
+                    member, handlerFile->casts().empty() ? nullptr : handlerFile->casts().front());
+                break;
+            }
+        }
+    }
+
+    testSystemPropsManagerClasses(manager);
+
+    if (handlerFile) {
+        std::cout << "\n[core handler bytecode probe]\n";
+        dumpScriptHandlerProbe(handlerFile, "Variable API", "CreateVariableManager");
+        dumpScriptHandlerProbe(handlerFile, "Object API", "createManager");
+        dumpScriptHandlerProbe(handlerFile, "Object API", "CreateObjectManager");
+    }
+
+    runCreateVariableManagerProbe(hostFile.get(), manager);
+
+    runHandlerTests(handlerFile, runtimeScript, secret1, secret2, secret3);
+
+    const bool memberOk = memberRef != nullptr || memberNum > 0;
+    const bool scriptOk = runtimeScript != nullptr;
+    if (!memberOk || !scriptOk) {
+        return 6;
+    }
+    return 0;
+}
