+    // Same rule `decode` applies to BITD, and the one DirPlayer states outright:
+    //     let data_was_uncompressed = reader.length >= expected_len;
+    if (!zlib && static_cast<int>(data.size()) >= expectedSize) {
+        if (static_cast<int>(data.size()) > expectedSize) {
+            return std::vector<std::uint8_t>(data.begin(), data.begin() + expectedSize);
+        }
+        return data;
+    }
+    if (zlib) {
+#ifdef LIBRESHOCKWAVE_HAVE_ZLIB
+        try {
+            auto inflated = io::BinaryReader::decompressZlib(data);
+            // ⚠ ALFA alpha planes are zlib-wrapped PackBits (DOUBLE compressed):
+            // zlib inflates to a stream that is ITSELF PackBits-compressed and
+            // still short of the plane. Decode that second layer. VMK's round
+            // "?" help buttons (JPEG bitmap + ALFA) came out garbled because the
+            // plane stopped at the zlib layer — inflated 164 bytes for an 18x18
+            // (324) alpha, so PackBits over the raw stream produced noise and the
+            // tail stayed opaque. Planes that are zlib-only inflate to exactly
+            // the plane size and skip this. MEASURED: inflate->164 then
+            // PackBits->324 reproduces the clean circle mask.
+            if (static_cast<int>(inflated.size()) < expectedSize) {
+                return decompressRLE(inflated, expectedSize);
+            }
+            if (inflated.size() > static_cast<std::size_t>(expectedSize)) {
+                inflated.resize(static_cast<std::size_t>(expectedSize));
+            }
+            return inflated;
+        } catch (const std::exception&) {
+            return decompressRLE(data, expectedSize);
+        }
+#else
+        return decompressRLE(data, expectedSize);
+#endif
+    }
+    return decompressRLE(data, expectedSize);
+}
