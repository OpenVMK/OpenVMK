+        if (!objectManagerLookupTruthy(context, objectManager, "managerExists", candidateId)) {
+            (void)dispatchObjectMethod(context, objectManager, "registerManager", {candidateId});
+        }
+        Datum registeredManager =
+            dispatchObjectMethod(context, objectManager, "getManager", {candidateId});
+        if (!registeredManager.isVoid()) {
+            return registeredManager;
+        }
+        Datum existingObject = dispatchObjectMethod(context, objectManager, "get", {candidateId});
+        if (!existingObject.isVoid()) {
+            return existingObject;
+        }
+    }
