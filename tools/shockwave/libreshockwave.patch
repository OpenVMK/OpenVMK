+        // what the client must pen-advance by, instead of canvas measureText
+        // (which is a fraction off and drifts across a line).
+        json << '"' << code << "\":{\"w\":" << w << ",\"h\":" << h
+             << ",\"left\":" << left << ",\"top\":" << top
+             << ",\"adv\":" << bf->getCharWidth(code);
+        if (w > 0) {
+            json << ",\"rows\":[";
+            for (int y = iy0; y <= iy1; ++y) {
+                if (y != iy0) json << ',';
+                json << '"';
+                for (int x = ix0; x <= ix1; ++x) {
+                    const std::uint32_t a = (dst[static_cast<std::size_t>(y) * W + x] >> 24U) & 0xFFU;
+                    json << std::hex << std::setw(2) << std::setfill('0') << a << std::dec;
+                }
+                json << '"';
+            }
+            json << ']';
+        }
+        json << '}';
+    }
+    json << "}}";
+
+    fs::create_directories(output.parent_path());
+    std::ofstream out(output, std::ios::binary);
+    out << json.str();
+    if (!out) {
+        std::cerr << "FAILED to write " << output << '\n';
+        return 1;
+    }
+    std::cout << "WROTE " << output.string() << "  size=" << size
+              << "  cell=" << bf->cellWidth() << "x" << bf->cellHeight()
+              << "  ascent=" << ascent << "  descent=" << descent
+              << "  hardEdges=" << (hardEdges ? "yes" : "no")
+              << "  glyphs with ink: " << inked << '\n';
+    return 0;
+}
diff --git a/cpp/apps/tools/CastRewrite.cpp b/cpp/apps/tools/CastRewrite.cpp
new file mode 100644
index 0000000..d231dca
--- /dev/null
+++ b/cpp/apps/tools/CastRewrite.cpp
@@ -0,0 +1,502 @@
+// Round-trip a Director cast: read an afterburner-compressed .cct and re-emit it
+// as a plain (uncompressed) RIFX that the real Shockwave plugin will load.
+//
+// Why plain RIFX: GetSecCastBuilder already synthesises one and the live GetSec
+// path proves the plugin accepts a cast we generate, so we do not need to
+// reimplement afterburner compression. We only need to round-trip members.
+//
+// Why chunk-level: members are copied as opaque decompressed byte blobs. Nothing
+// here parses bitmaps, JPEG payloads or Lingo bytecode, so nothing can silently
+// re-encode them.
+//
+// ⚠ mmap entry INDEX is the chunk id (DirectorFile::loadRIFX does
+// `chunkId = id::ChunkId(index)`), and KeyTable/Cast chunks reference members by
+// that id. Entries must therefore be emitted in resourceId order with gaps
+// filled by empty slots, or every cross-reference in the cast breaks.
+//
+// Usage:
+//   libreshockwave_cast_rewrite <input.cct> <output.cct> [--list]
+//   libreshockwave_cast_rewrite <input.cct> <output.cct> --set-text <id>=<file>
+//
+// `--list` prints the chunk inventory and writes nothing.
+// `--set-text` replaces chunk <id>'s payload with the contents of <file>, which
+// is how a text member (e.g. vmk_reg_step1.window) gets edited.
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "libreshockwave/DirectorFile.hpp"
+#include "libreshockwave/format/AfterburnerReader.hpp"
+#include "libreshockwave/format/ChunkInfo.hpp"
+#include "libreshockwave/io/BinaryReader.hpp"
+
+namespace fs = std::filesystem;
+using libreshockwave::format::AfterburnerReader;
+using libreshockwave::format::ChunkInfo;
+using libreshockwave::io::BinaryReader;
+using libreshockwave::io::ByteOrder;
+
+namespace {
+
+constexpr int kMmapHeaderLength = 24; // after the 8-byte chunk header
+constexpr int kMmapEntryLength = 20;
+
+std::vector<std::uint8_t> readFile(const fs::path& path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) throw std::runtime_error("cannot open " + path.string());
+    in.seekg(0, std::ios::end);
+    const auto size = in.tellg();
+    in.seekg(0, std::ios::beg);
+    std::vector<std::uint8_t> data(static_cast<std::size_t>(size));
+    if (!data.empty()) in.read(reinterpret_cast<char*>(data.data()), size);
+    return data;
+}
+
+// ⚠ Endianness is not cosmetic here. A cast whose container is XFIR holds
+// little-endian chunk PAYLOADS. Emitting a big-endian RIFX wrapper around them
+// produces a file whose index parses but whose every chunk misreads -- the
+// symptom is "N members, 0 text, 0 raw" from the asset extractor. The header,
+// the mmap and the per-chunk headers must all use the SOURCE's byte order, and
+// the container fourCC must match it (XFIR for LE, RIFX for BE).
+bool gLittleEndian = false;
+
+void appendFourCC(std::vector<std::uint8_t>& out, const std::string& value) {
+    char raw[4];
+    for (int i = 0; i < 4; ++i) {
+        raw[i] = i < static_cast<int>(value.size()) ? value[i] : ' ';
+    }
+    if (gLittleEndian) {
+        for (int i = 3; i >= 0; --i) out.push_back(static_cast<std::uint8_t>(raw[i]));
+    } else {
+        for (int i = 0; i < 4; ++i) out.push_back(static_cast<std::uint8_t>(raw[i]));
+    }
+}
+
+void appendI32(std::vector<std::uint8_t>& out, std::uint32_t value) {
+    if (gLittleEndian) {
+        out.push_back(static_cast<std::uint8_t>(value & 0xFF));
+        out.push_back(static_cast<std::uint8_t>((value >> 8) & 0xFF));
+        out.push_back(static_cast<std::uint8_t>((value >> 16) & 0xFF));
+        out.push_back(static_cast<std::uint8_t>((value >> 24) & 0xFF));
+        return;
+    }
+    out.push_back(static_cast<std::uint8_t>((value >> 24) & 0xFF));
+    out.push_back(static_cast<std::uint8_t>((value >> 16) & 0xFF));
+    out.push_back(static_cast<std::uint8_t>((value >> 8) & 0xFF));
+    out.push_back(static_cast<std::uint8_t>(value & 0xFF));
+}
+
+void appendI16(std::vector<std::uint8_t>& out, int value) {
+    const auto raw = static_cast<std::uint16_t>(value);
+    if (gLittleEndian) {
+        out.push_back(static_cast<std::uint8_t>(raw & 0xFF));
+        out.push_back(static_cast<std::uint8_t>((raw >> 8) & 0xFF));
+        return;
+    }
+    out.push_back(static_cast<std::uint8_t>((raw >> 8) & 0xFF));
+    out.push_back(static_cast<std::uint8_t>(raw & 0xFF));
+}
+
+void putI32At(std::vector<std::uint8_t>& out, std::size_t at, std::uint32_t value) {
+    if (gLittleEndian) {
+        out[at] = static_cast<std::uint8_t>(value & 0xFF);
+        out[at + 1] = static_cast<std::uint8_t>((value >> 8) & 0xFF);
+        out[at + 2] = static_cast<std::uint8_t>((value >> 16) & 0xFF);
+        out[at + 3] = static_cast<std::uint8_t>((value >> 24) & 0xFF);
+        return;
+    }
+    out[at] = static_cast<std::uint8_t>((value >> 24) & 0xFF);
+    out[at + 1] = static_cast<std::uint8_t>((value >> 16) & 0xFF);
+    out[at + 2] = static_cast<std::uint8_t>((value >> 8) & 0xFF);
+    out[at + 3] = static_cast<std::uint8_t>(value & 0xFF);
+}
+
+struct Member {
+    int id = 0;
+    std::string fourCC;
+    std::vector<std::uint8_t> data;
+};
+
+// Build a plain RIFX. imap and mmap are written outside the entry table, exactly
+// as GetSecCastBuilder does -- that layout is the one proven to load in the real
+// plugin. Entry i describes chunk id i; absent ids get a zeroed slot, which
+// loadRIFX skips via `fourcc != 0 && offset > 0`.
+std::vector<std::uint8_t> buildRifx(const std::vector<Member>& members,
+                                    int directorVersion,
+                                    const std::string& containerType) {
+    int maxId = -1;
+    for (const auto& m : members) maxId = std::max(maxId, m.id);
+    const int entryCount = maxId + 1;
+
+    std::map<int, const Member*> byId;
+    for (const auto& m : members) byId[m.id] = &m;
+
+    // Layout mirrors a KNOWN-GOOD Disney uncompressed cast
+    // (vmk_clothes/vmk_avatar_ht_cst_1.cst): container(12) + imap header(8) +
+    // imap payload(24) => mmap starts at 44.
+    constexpr int kImapPayloadLength = 24;
+    constexpr int mmapOffset = 12 + 8 + kImapPayloadLength; // 44
+    const int mmapPayloadLength = kMmapHeaderLength + entryCount * kMmapEntryLength;
+    const int payloadBase = mmapOffset + 8 + mmapPayloadLength;
+
+    // Lay out chunk positions first: each chunk is fourcc(4)+len(4)+data, padded
+    // to an even boundary. The mmap entry offset points at the fourcc.
+    std::map<int, int> headerOffset;
+    int cursor = payloadBase;
+    for (const auto& [id, member] : byId) {
+        headerOffset[id] = cursor;
+        cursor += 8 + static_cast<int>(member->data.size());
+        if ((member->data.size() % 2) != 0) ++cursor; // pad to even
+    }
+
+    // Logical names throughout; appendFourCC reverses the bytes for LE, so
+    // "RIFX" lands on disk as XFIR exactly as Director writes it.
+    //
+    // ⚠ containerType MUST match what the source was. An afterburner CAST is
+    // FGDC and its uncompressed form is MC95; an afterburner MOVIE is FGDM ->
+    // MV93. Emitting MV93 for a cast hands the plugin a file that claims to be a
+    // movie but contains cast chunks -- which is how the first attempt died.
+    std::vector<std::uint8_t> out;
+    appendFourCC(out, "RIFX");
+    appendI32(out, 0); // patched at the end
+    appendFourCC(out, containerType);
+
+    // imap payload is 24 bytes / FOUR fields in the reference cast, not 12/three.
+    appendFourCC(out, "imap");
+    appendI32(out, static_cast<std::uint32_t>(kImapPayloadLength));
+    // 24 bytes == SIX i32 fields.
+    appendI32(out, 1);
+    appendI32(out, static_cast<std::uint32_t>(mmapOffset));
+    appendI32(out, static_cast<std::uint32_t>(directorVersion));
+    appendI32(out, 0);
+    appendI32(out, 0);
+    appendI32(out, 0);
+
+    appendFourCC(out, "mmap");
+    appendI32(out, static_cast<std::uint32_t>(mmapPayloadLength));
+    appendI16(out, kMmapHeaderLength);
+    appendI16(out, kMmapEntryLength);
+    appendI32(out, static_cast<std::uint32_t>(entryCount)); // allocated
+    appendI32(out, static_cast<std::uint32_t>(entryCount)); // used
+    appendI32(out, 0);
+    appendI32(out, 0);
+    appendI32(out, 0);
+
+    // Slot convention, read off the reference cast:
+    //   0 = RIFX (the file describing itself), 1 = imap, 2 = mmap, 3+ = content.
+    // Afterburner ids line up once ILS (its id 2) is dropped: KEY* is id 3 in
+    // both. Flags are NOT decorative -- the reference uses RIFX=1, imap=129,
+    // mmap=0, free=12, and content is 128 for KEY*/DRCF/Cinf/VERS/BITD, 0 for
+    // CASt/CAS*/Thum.
+    const auto flagsFor = [](const std::string& fourCC) -> int {
+        if (fourCC == "KEY*" || fourCC == "DRCF" || fourCC == "VWCF" || fourCC == "Cinf" ||
+            fourCC == "VERS" || fourCC == "BITD" || fourCC == "LctX" || fourCC == "Lctx") {
+            return 128;
+        }
+        return 0;
+    };
+
+    std::size_t rifxEntryLengthAt = 0;
+    for (int id = 0; id < entryCount; ++id) {
+        if (id == 0) {
+            appendFourCC(out, "RIFX");
+            rifxEntryLengthAt = out.size(); // patched once the total is known
+            appendI32(out, 0);
+            appendI32(out, 0);
+            appendI16(out, 1);
+            appendI16(out, 0);
+            appendI32(out, 0);
+            continue;
+        }
+        if (id == 1) {
+            appendFourCC(out, "imap");
+            appendI32(out, static_cast<std::uint32_t>(kImapPayloadLength));
+            appendI32(out, 12);
+            appendI16(out, 129);
+            appendI16(out, 0);
+            appendI32(out, 0);
+            continue;
+        }
+        if (id == 2) {
+            appendFourCC(out, "mmap");
+            appendI32(out, static_cast<std::uint32_t>(mmapPayloadLength));
+            appendI32(out, static_cast<std::uint32_t>(mmapOffset));
+            appendI16(out, 0);
+            appendI16(out, 0);
+            appendI32(out, 0);
+            continue;
+        }
+        const auto found = byId.find(id);
+        if (found == byId.end()) {
+            appendFourCC(out, "free");
+            appendI32(out, 0);
+            appendI32(out, 0);
+            appendI16(out, 12);
+            appendI16(out, 0);
+            appendI32(out, 0);
+            continue;
+        }
+        const auto* member = found->second;
+        appendFourCC(out, member->fourCC);
+        appendI32(out, static_cast<std::uint32_t>(member->data.size()));
+        appendI32(out, static_cast<std::uint32_t>(headerOffset[id]));
+        appendI16(out, flagsFor(member->fourCC));
+        appendI16(out, 0);
+        appendI32(out, 0);
+    }
+
+    for (const auto& [id, member] : byId) {
+        if (static_cast<int>(out.size()) != headerOffset.at(id)) {
+            throw std::runtime_error("layout drift at chunk " + std::to_string(id) + ": expected " +
+                                     std::to_string(headerOffset.at(id)) + ", at " +
+                                     std::to_string(out.size()));
+        }
+        appendFourCC(out, member->fourCC);
+        appendI32(out, static_cast<std::uint32_t>(member->data.size()));
+        out.insert(out.end(), member->data.begin(), member->data.end());
+        if ((member->data.size() % 2) != 0) out.push_back(0);
+    }
+
+    putI32At(out, 4, static_cast<std::uint32_t>(out.size() - 8));
+    // Entry 0 (RIFX) carries the same length as the container header.
+    putI32At(out, rifxEntryLengthAt, static_cast<std::uint32_t>(out.size() - 8));
+    return out;
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 3) {
+        std::cerr << "usage: libreshockwave_cast_rewrite <input.cct> <output.cct> [--list]"
+                     " [--set-text <id>=<file>]\n";
+        return 2;
+    }
+
+    const fs::path input = argv[1];
+    const fs::path output = argv[2];
+    bool listOnly = false;
+    std::map<int, fs::path> replacements;
+    std::map<int, fs::path> dumps;
+
+    for (int i = 3; i < argc; ++i) {
+        const std::string arg = argv[i];
+        if (arg == "--list") {
+            listOnly = true;
+        } else if (arg == "--dump" && i + 1 < argc) {
+            const std::string spec = argv[++i];
+            const auto eq = spec.find('=');
+            if (eq == std::string::npos) {
+                std::cerr << "bad --dump (want <id>=<file>): " << spec << '\n';
+                return 2;
+            }
+            dumps[std::stoi(spec.substr(0, eq))] = spec.substr(eq + 1);
+        } else if (arg == "--set-text" && i + 1 < argc) {
+            const std::string spec = argv[++i];
+            const auto eq = spec.find('=');
+            if (eq == std::string::npos) {
+                std::cerr << "bad --set-text (want <id>=<file>): " << spec << '\n';
+                return 2;
+            }
+            replacements[std::stoi(spec.substr(0, eq))] = spec.substr(eq + 1);
+        } else {
+            std::cerr << "unknown argument: " << arg << '\n';
+            return 2;
+        }
+    }
+
+    try {
+        auto data = readFile(input);
+        BinaryReader reader(data, ByteOrder::BigEndian);
+        const auto containerFourCC = reader.readFourCC();
+        const auto containerName = BinaryReader::fourCCToString(containerFourCC);
+
+        ByteOrder endian = ByteOrder::BigEndian;
+        if (containerName == "XFIR") {
+            endian = ByteOrder::LittleEndian;
+        } else if (containerName != "RIFX") {
+            std::cerr << "not a RIFX/XFIR file: " << containerName << '\n';
+            return 1;
+        }
+        gLittleEndian = (endian == ByteOrder::LittleEndian);
+        reader.setOrder(endian);
+        (void)reader.readI32();
+        const auto movieType = BinaryReader::fourCCToString(reader.readI32());
+        const bool afterburner = (movieType == "FGDM" || movieType == "FGDC");
+        // ⚠ MEASURED, not guessed: Disney's own uncompressed external casts
+        // (e.g. vmk_clothes/vmk_avatar_ht_cst_1.cst) declare **MV93**, even
+        // though their afterburner form is FGDC. v2 used MC95 on the assumption
+        // that "cast" needed its own type; that was wrong. Both forms use MV93.
+        const std::string containerType = "MV93";
+        (void)movieType;
+
+        // ⚠ These are the afterburner CONTAINER's own bookkeeping, not content.
+        // ILS is the initial-load segment whose payload we have already unpacked
+        // into the individual chunks; re-emitting it into a plain RIFX is
+        // meaningless at best. For a plain-RIFX INPUT the equivalents are the
+        // slots the writer regenerates itself (RIFX/imap/mmap) plus free/junk.
+        const auto isContainerChunk = [](const std::string& fourCC) {
+            return fourCC == "ILS " || fourCC == "ILS" || fourCC == "Fver" ||
+                   fourCC == "Fcdr" || fourCC == "ABMP" || fourCC == "FGEI" ||
+                   fourCC == "RIFX" || fourCC == "imap" || fourCC == "mmap" ||
+                   fourCC == "free" || fourCC == "junk";
+        };
+
+        std::vector<Member> members;
+        std::size_t replaced = 0;
+
+        // ---- plain-RIFX input: the SELF-CHECK path -------------------------
+        // Reading an already-uncompressed cast lets us re-emit it and diff
+        // against the original offline. If the writer cannot reproduce a file we
+        // can read, the diff says exactly where -- which beats guessing against
+        // the plugin, whose only failure signal is a silent freeze.
+        if (!afterburner) {
+            auto file = libreshockwave::DirectorFile::load(data);
+            if (!file) {
+                std::cerr << "could not load plain RIFX input\n";
+                return 1;
+            }
+            for (const auto& [chunkIdValue, info] : file->chunkInfo()) {
+                const auto fourCC = BinaryReader::fourCCToString(info.fourcc);
+                if (isContainerChunk(fourCC)) continue;
+                if (info.offset < 0 || info.length < 0) continue;
+                const auto begin = static_cast<std::size_t>(info.offset);
+                const auto end = begin + static_cast<std::size_t>(info.length);
+                if (end > data.size()) {
+                    std::cerr << "  ! chunk " << chunkIdValue << " (" << fourCC
+                              << ") runs past EOF - SKIPPED\n";
+                    continue;
+                }
+                members.push_back(Member{chunkIdValue, fourCC,
+                                         std::vector<std::uint8_t>(data.begin() + begin,
+                                                                   data.begin() + end)});
+            }
+            std::cout << input.filename().string() << ": PLAIN RIFX, " << members.size()
+                      << " content chunks, director " << file->version() << ", "
+                      << (endian == ByteOrder::BigEndian ? "BE" : "LE") << '\n';
+            if (listOnly) {
+                for (const auto& m : members) {
+                    std::cout << "  id=" << m.id << "\t" << m.fourCC << "\t" << m.data.size()
+                              << " bytes\n";
+                }
+                return 0;
+            }
+            const auto rebuilt = buildRifx(members, file->version(), containerType);
+            std::ofstream out(output, std::ios::binary);
+            out.write(reinterpret_cast<const char*>(rebuilt.data()),
+                      static_cast<std::streamsize>(rebuilt.size()));
+            out.close();
+            std::cout << "wrote " << output.string() << " (" << rebuilt.size() << " bytes, input was "
+                      << data.size() << ")\n";
+            if (rebuilt.size() == data.size() &&
+                std::memcmp(rebuilt.data(), data.data(), data.size()) == 0) {
+                std::cout << "SELF-CHECK: byte-identical to the input ✓\n";
+            } else {
+                std::cout << "SELF-CHECK: DIFFERS from the input (expected -- free/junk slots and\n"
+                             "            chunk ordering are not reproduced; compare structure)\n";
+            }
+            return 0;
+        }
+
+        AfterburnerReader ab(reader, endian);
+        ab.parse();
+        const auto infos = ab.chunkInfos();
+        members.reserve(infos.size());
+        for (const auto& info : infos) {
+            if (isContainerChunk(info.fourCC)) {
+                std::cout << "  skipping container chunk " << info.resourceId << " (" << info.fourCC
+                          << ")\n";
+                continue;
+            }
+            auto payload = ab.getChunkData(info.resourceId);
+            if (!payload.has_value()) {
+                std::cerr << "  ! chunk " << info.resourceId << " (" << info.fourCC
+                          << ") could not be decompressed - SKIPPED\n";
+                continue;
+            }
+            if (const auto want = dumps.find(info.resourceId); want != dumps.end()) {
+                std::ofstream raw(want->second, std::ios::binary);
+                raw.write(reinterpret_cast<const char*>(payload->data()),
+                          static_cast<std::streamsize>(payload->size()));
+                std::cout << "  dumped chunk " << info.resourceId << " (" << info.fourCC << ", "
+                          << payload->size() << " bytes) -> " << want->second.string() << '\n';
+            }
+            if (const auto hit = replacements.find(info.resourceId); hit != replacements.end()) {
+                payload = readFile(hit->second);
+                std::cout << "  replaced chunk " << info.resourceId << " (" << info.fourCC
+                          << ") with " << hit->second.string() << " (" << payload->size()
+                          << " bytes)\n";
+                ++replaced;
+            }
+            members.push_back(Member{info.resourceId, info.fourCC, std::move(*payload)});
+        }
+
+        std::cout << input.filename().string() << ": " << members.size() << " chunks, director "
+                  << ab.directorVersion() << ", " << (endian == ByteOrder::BigEndian ? "BE" : "LE")
+                  << '\n';
+
+        if (listOnly) {
+            // Show the AFTERBURNER sizes too: a surgical in-place patch is only
+            // possible if a re-deflated chunk fits the original compressedSize.
+            std::map<int, const ChunkInfo*> infoById;
+            for (const auto& info : infos) infoById[info.resourceId] = &info;
+            for (const auto& m : members) {
+                std::cout << "  id=" << m.id << "\t" << m.fourCC << "\tuncompressed="
+                          << m.data.size();
+                if (const auto hit = infoById.find(m.id); hit != infoById.end()) {
+                    std::cout << "\tabmp: comp=" << hit->second->compressedSize
+                              << " uncomp=" << hit->second->uncompressedSize
+                              << " off=" << hit->second->offset
+                              << (hit->second->isZlibCompressed() ? " zlib" : " raw");
+                }
+                std::cout << '\n';
+            }
+            return 0;
+        }
+        if (replaced != replacements.size()) {
+            std::cerr << "ERROR: " << (replacements.size() - replaced)
+                      << " --set-text target(s) not found among the chunk ids\n";
+            return 1;
+        }
+
+        // ⚠ AfterburnerReader::directorVersion() is the FVER version (it returns
+        // 1 for these casts), NOT the Director version. The real one comes from
+        // the ConfigChunk, which DirectorFile resolves -- 1858 for the VMK UI
+        // casts. Writing 1 into the imap is suspect #1 for the first failure.
+        int imapVersion = ab.directorVersion();
+        try {
+            if (auto probe = libreshockwave::DirectorFile::load(data); probe && probe->version() > 1) {
+                imapVersion = probe->version();
+            }
+        } catch (...) {
+            // fall back to whatever the afterburner header claimed
+        }
+        std::cout << "container=" << containerType << " imapVersion=" << imapVersion
+                  << " (afterburner reported " << ab.directorVersion() << ")\n";
+
+        const auto rifx = buildRifx(members, imapVersion, containerType);
+        std::ofstream out(output, std::ios::binary);
+        out.write(reinterpret_cast<const char*>(rifx.data()), static_cast<std::streamsize>(rifx.size()));
+        out.close();
+        std::cout << "wrote " << output.string() << " (" << rifx.size() << " bytes)\n";
+
+        // Self-check: the emitted file must load, and every chunk must survive.
+        auto verify = libreshockwave::DirectorFile::load(readFile(output));
+        if (!verify) {
+            std::cerr << "VERIFY FAILED: output does not load\n";
+            return 1;
+        }
+        std::cout << "verify: loads OK, " << verify->chunkInfo().size() << " chunks indexed, "
+                  << verify->castMembers().size() << " cast members, " << verify->scripts().size()
+                  << " scripts\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "FAILED: " << error.what() << '\n';
+        return 1;
+    }
+}
