+std::vector<Datum> managerIdLookupCandidates(const Datum& managerId) {
+    std::vector<Datum> candidates;
+    candidates.push_back(normalizeManagerId(managerId));
+    if (!managerId.isString()) {
+        candidates.push_back(Datum::of(toStringLikeJava(managerId)));
