+        if (!equalsIgnoreCase(names->getName(handler.nameId), handlerName)) {
+            continue;
+        }
+        bool patched = false;
+        for (auto& instruction : handler.instructions) {
+            if (instruction.opcode == opcode && instruction.argument == oldArgument) {
+                instruction.argument = newArgument;
+                patched = true;
+            }
+        }
+        return patched;
+    }
+    return false;
