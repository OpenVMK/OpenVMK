-- Script
property pLogoSpr
property pState

on construct this
  tSession = createObject(#session, getClassVariable("variable.manager.class"))
  tSession.set("client_startdate", date())
  tSession.set("client_starttime", 8, 0)
  tSession.set("client_version", getVariable("system.version"))
  tSession.set("client_url", the moviePath)
  tSession.set("client_lastclick", EMPTY)
  createObject(#headers, getClassVariable("variable.manager.class"))
  createObject(#classes, getClassVariable("variable.manager.class"))
  createObject(#cache, getClassVariable("variable.manager.class"))
  createBroker(#Initialize)
  return updateState(this, "load_variables")
end
on deconstruct this
  trace("deconstruct")
  return hideLogo(this)
end
on showLogo this
  trace("showLogo")
  if memberExists("Logo") then
    tmember = member(getmemnum("Logo"))
    this.pLogoSpr = sprite(reserveSprite(getID(this)))
    this.pLogoSpr.ink = 0
    this.pLogoSpr.blend = 100
    this.pLogoSpr.member = tmember
    this.pLogoSpr.locZ = -20000001
    this.pLogoSpr.loc = point((the stage).rect.width / 2 + 5, (the stage).rect.height / 2 - tmember.height / 2 + 150)
    this.pLogoSpr.width = member(getmemnum("Logo")).image.width
    this.pLogoSpr.height = member(getmemnum("Logo")).image.height
  end if
  return 1
end
on hideLogo this
  trace("hideLogo")
  if this.pLogoSpr.ilk = #sprite then
    releaseSprite(this.pLogoSpr.spriteNum)
    this.pLogoSpr = VOID
  end if
  return 1
end
on updateState me, tstate
  if not externalParamValue("sw3") = "58f5cd62-09e8-44b4-9091-116a16250498" then
    _player.debugPlaybackEnabled = 1
  end if
  if tstate = "load_variables" then
    me.pState = tstate
    showLogo(me)
    cursor(4)
    return me.updateState("load_params")
  else
    if tstate = "load_params" then
      me.pState = tstate
      if the runMode contains "Plugin" then
        tDelim = the itemDelimiter
        the itemDelimiter = "="
        repeat with i = 1 to 9
          tParam = externalParamValue("sw" & i)
          if not voidp(tParam) then
            if tParam.item.count > 1 then
              getVariableManager().set(tParam.item[1], tParam.item[2..tParam.item.count])
            end if
          end if
        end repeat
      end if
      setDebugLevel(getIntVariable("system.debug", 0))
      initConvList(getStringServices())
      puppetTempo(getIntVariable("system.tempo", 30))
      if variableExists("client.reload.url") then
        getObject(#session).set("client_url", getVariable("client.reload.url"))
      end if
      if getIntVariable("system.debug") > 2 then
        me.m_bLogger = 1
      end if
      tCastCount = 40
      tCode = script("CInit").m_sSecretCode3
      repeat with i = 1 to tCastCount
        getVariableManager().set("cast.entry." & i, "7a684fb5-a766-4fd9-9877-b00e2cafc03a/" & hex_md5("onepoundfishonepoundfish" & tCode & i & "5ae0df5c-fb39-426e-8214-53d5b2d54a69"))
      end repeat
      if not externalParamValue("sw3") = "58f5cd62-09e8-44b4-9091-116a16250498" then
        _player.debugPlaybackEnabled = 1
      end if
      getVariableManager().set("body_part_cast", getVariableManager().get("cast.entry.26"))
