      getVariableManager().set("room.code.95", "new_orleans_square")
      getVariableManager().set("room.code.96", "disney_gallery")
      getVariableManager().set("room.code.97", "blue_bayou")
      getVariableManager().set("room.code.98", "epcot_entrance_private")
      getVariableManager().set("room.code.99", "fantasyland_courtyard")
      getVariableManager().set("rpgfurnipopup.url", "https://admin.virtualmagickingdom.com/housekeeping/moderator/rpgfurnipopup/prepare.action?entityIdStr")
      getVariableManager().set("struct.font.bold", " [#font:" & QUOTE & "Foxley 816 *" & QUOTE & ", #fontSize:16, #lineHeight:18, #fixedLineSpace:18, #color:rgb(" & QUOTE & "#000000" & QUOTE & "), #ilk:#struct, #fontStyle:[#bold]]")
      getVariableManager().set("struct.font.chat.bold", " [#font:" & QUOTE & "Foxley 816 Bold *" & QUOTE & ", #fontSize:16, #lineHeight:13, #fixedLineSpace:0,  #color:rgb(" & QUOTE & "#000000" & QUOTE & "), #ilk:#struct, #fontStyle:[#plain]]")
      getVariableManager().set("struct.font.chat.plain", " [#font:" & QUOTE & "Foxley 816 *" & QUOTE & ", #fontSize:16, #lineHeight:13, #fixedLineSpace:0,  #color:rgb(" & QUOTE & "#000000" & QUOTE & "), #ilk:#struct, #fontStyle:[#plain]]")
      getVariableManager().set("struct.font.italic", " [#font:" & QUOTE & "Foxley 816 *" & QUOTE & ", #fontSize:16, #lineHeight:18, #fixedLineSpace:18, #color:rgb(" & QUOTE & "#000000" & QUOTE & "), #ilk:#struct, #fontStyle:[#italic]]")
      getVariableManager().set("struct.font.plain", " [#font:" & QUOTE & "Foxley 816 *" & QUOTE & ", #fontSize:16, #lineHeight:18, #fixedLineSpace:18, #color:rgb(" & QUOTE & "#000000" & QUOTE & "), #ilk:#struct, #fontStyle:[#plain]]")
      getVariableManager().set("tutorials_url", "http://127.0.0.1/homepage/download/tutorials_6")
      getVariableManager().set("weapon_cast", "vmk_avatar/gfx_vmks_weapons")
      getObject(#session).set("sessionID", externalParamValue("sw1"))
      return updateState(me, "load_texts")
    else
      if tstate = "load_texts" then
        me.pState = tstate
        tURL = getVariable("external.texts.txt")
        tMemName = tURL
        if tMemName = 0 or tMemName = EMPTY then
          return updateState(me, "load_casts")
        end if
        if tURL contains "?" then
          tParamDelim = "&"
        end if
        tParamDelim = "?"
        if the moviePath contains "http://" then
          tURL = tURL
        else
          if tURL contains "http://" then
            tURL = tURL
          end if
        end if
        tMemNum = queueDownload(tURL, tMemName, #field)
        return registerDownloadCallback(tMemNum, #updateState, getID(me), "feed_texts")
      else
        if tstate = "feed_texts" then
          me.pState = tstate
          if not getObject(#session).exists("ExternalTexts") then
            tTxtFile = getVariable("external.texts.txt")
            if tTxtFile <> 0 then
              if memberExists(tTxtFile) then
                dumpTextField(tTxtFile)
                removeMember(tTxtFile)
                getObject(#session).set("ExternalTexts", 1)
              end if
            end if
          end if
          tURL = getVariable("encrypted.texts.txt")
          tMemName = tURL
          if tMemName = 0 or tMemName = EMPTY then
            return updateState(me, "load_casts")
          end if
          if tURL contains "?" then
            tParamDelim = "&"
          end if
          tParamDelim = "?"
          if the moviePath contains "http://" then
            tURL = tURL
          else
            if tURL contains "http://" then
              tURL = tURL
            end if
          end if
          tMemNum = queueDownload(tURL, tMemName, #field)
          return registerDownloadCallback(tMemNum, #updateState, getID(me), "load_casts")
        else
          if tstate = "load_casts" then
            me.pState = tstate
            tCastList = []
            i = 1
            repeat with i = 1 to the number of castLibs
              if not variableExists("cast.entry." & i) then
              else
                tFileName = getVariable("cast.entry." & i)
                tCastList.add(tFileName)
              end if
              i = i + 1
            end repeat
            trace(tCastList)
            if count(tCastList) > 0 then
              tLoadID = startCastLoad(tCastList, 1)
              if getVariable("loading.bar.active") then
                loadBar = showLoadingBar(tLoadID, propList(#buffer, #window))
                loading = getObject(loadBar)
                loadWindow = getWindow(loading.pWindowID)
                loadWindow.moveTo(50, 525)
              end if
              return registerCastloadCallback(tLoadID, #updateState, getID(me), "validate_resources")
            else
              return updateState(me, "init_threads")
            end if
          else
            if tstate = "validate_resources" then
              me.pState = tstate
              tCastList = []
              tNewList = []
              tVarMgr = getVariableManager()
              i = 1
              repeat while i <= the number of castLibs
                if tVarMgr.exists("cast.entry." & i) then
                  tFileName = tVarMgr.get("cast.entry." & i)
                  tCastList.add(tFileName)
                end if
                i = i + 1
              end repeat
              if count(tCastList) > 0 then
                i = 1
                repeat while i <= tCastList.count
                  tCast = tCastList[i]
                  if not castExists(tCast) then
                    tNewList.add(tCast)
                  end if
                  i = i + 1
                end repeat
              end if
              if count(tNewList) > 0 then
                tLoadID = startCastLoad(tNewList, 1)
                if getVariable("loading.bar.active") then
                end if
                return registerCastloadCallback(tLoadID, #updateState, getID(me), "validate_resources")
              end if
              return updateState(me, "init_threads")
            else
              if tstate = "init_threads" then
                if not getObject(#session).exists("EncryptedTexts") then
                  tTxtFile = getVariable("encrypted.texts.txt")
                  if tTxtFile <> 0 and value(getVariable("clienttexts.encrypt")) then
                    createMember("decryptField", #field)
                    tPublicKey = getVariable("clienttexts.key")
                    tOrigin = getVariable("clienttexts.charactersencrypted")
                    tPrivateKey = ShufflerCryptCreateTable(tOrigin, tPublicKey)
                    ShufflerCryptUnCode(tTxtFile, "decryptField", tPrivateKey, tOrigin)
                    removeMember(tTxtFile)
                    tTxtFile = "decryptField"
                  end if
                  if tTxtFile <> 0 then
                    if memberExists(tTxtFile) then
                      dumpTextField(tTxtFile)
                      removeMember(tTxtFile)
                      getObject(#session).set("EncryptedTexts", 1)
                    end if
                  end if
                end if
                me.pState = tstate
                cursor(0)
                getVariableManager().set("redeemprices", value(getText("sellprices", "[]")))
                getVariableManager().set("nontradable", value(getText("notrade", "[]")))
                getObject(#inventory_component).m_mp_iRedeemPrice = getVariableValue("redeemprices")
                hideLogo(me)
                getThreadManager().initAll()
                return executeMessage(#Initialize, "initialize")
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  return error(me, "Unknown state:" & tstate, #updateState)
end
on by2str str
  out = EMPTY
  repeat with i = 1 to str.count
    out = out & numToChar(str[i])
  end repeat
  return out
end